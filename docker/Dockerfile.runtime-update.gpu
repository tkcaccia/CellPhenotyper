ARG BASE_IMAGE=ghcr.io/tkcaccia/cellphenotyper:2.2-gpu-amd64
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG CONCH_REVISION=141cc09c
ARG FASTEMBEDR_REVISION=a74ce04633efe324c8137498320816a55b9fff61
ARG KODAMA_REVISION=8be4735436116a5a4b0fabb9df2d64de16e3d80e
ARG BIOCGENERICS_REVISION=32f12a9b54e4fe33dc447f3e2c488b0d91b6a61b
ARG S4VECTORS_REVISION=fc819a547a51d682f7788ae16a42c26840b1ed2f
ARG FASTPLS_REVISION=dcf45cccee8a1cb1a3ae8b3353a410ab0902162f

RUN chmod 0644 /opt/cellphenotyper/models/hovernet/hovernet_fast_monusac_type_tf2pytorch.tar

RUN apt-get update && apt-get install -y --no-install-recommends libuv1-dev && \
    rm -rf /var/lib/apt/lists/*

RUN set -euo pipefail && \
    micromamba run -n stardist pip install --no-cache-dir \
      "transformers>=4.51,<5" einops-exts ftfy regex tokenizers && \
    micromamba run -n stardist pip install --no-cache-dir --no-deps \
      "git+https://github.com/MahmoodLab/CONCH.git@${CONCH_REVISION}" && \
    micromamba run -n stardist python -c \
      "import conch, einops_exts, torch, transformers; assert transformers.__version__.split('.')[0] == '4'; assert torch.cuda.is_available() or torch.backends.cuda.is_built(); print('TITAN runtime dependencies passed')"

RUN set -euo pipefail && \
    if [ -d /opt/micromamba/envs/kodama-r ]; then \
      micromamba env remove -y -n kodama-r; \
    fi && \
    micromamba create -y -n kodama-r -c conda-forge -c bioconda --channel-priority strict \
      'r-base>=4.6' zlib libuv

RUN set -euo pipefail && \
    export MAKEFLAGS=-j1 && \
    micromamba run -n kodama-r Rscript -e \
      'stopifnot(getRversion() >= "4.6.0"); install.packages(c("Rcpp", "withr", "generics", "data.table", "R.utils", "remotes", "Matrix", "float", "RcppArmadillo", "RcppEigen", "ggplot2", "rmarkdown"), repos="https://cloud.r-project.org", Ncpus=1L)'

RUN set -euo pipefail && \
    micromamba run -n kodama-r Rscript -e \
      "remotes::install_github('tkcaccia/fastPLS@${FASTPLS_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n kodama-r Rscript -e \
      "remotes::install_github('Bioconductor/BiocGenerics@${BIOCGENERICS_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n kodama-r Rscript -e \
      "remotes::install_github('Bioconductor/S4Vectors@${S4VECTORS_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n kodama-r Rscript -e \
      "remotes::install_github('tkcaccia/fastEmbedR@${FASTEMBEDR_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n kodama-r Rscript -e \
      "remotes::install_github('tkcaccia/KODAMA@${KODAMA_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n kodama-r Rscript -e \
      'stopifnot(getRversion() >= "4.6.0", packageVersion("fastEmbedR") >= "0.99.5", packageVersion("KODAMA") == "0.99.7"); library(KODAMA); library(fastEmbedR); library(fastPLS); library(data.table); library(ggplot2); library(rmarkdown); cat("KODAMA and PathoFMPred runtime dependencies passed\n")' && \
    micromamba clean -a -y

RUN mkdir -p /opt/cellphenotyper/empty-r-library
ENV R_LIBS_USER=/opt/cellphenotyper/empty-r-library
ENV R_ENVIRON_USER=/dev/null
ENV R_PROFILE_USER=/dev/null

WORKDIR /opt/cellphenotyper
COPY main.nf nextflow.config pipeline_paramers.yml README.md PARAMETERS.md OUTPUT.md INSTALL.md RELEASE.md TROUBLESHOOTING.md TUTORIAL.md LINUX_UPDATE.md UPSTREAM_DIFFS.md /opt/cellphenotyper/
COPY bin /opt/cellphenotyper/bin
COPY modules /opt/cellphenotyper/modules
COPY subworkflows /opt/cellphenotyper/subworkflows
COPY docker /opt/cellphenotyper/docker
COPY examples /opt/cellphenotyper/examples
COPY singularity /opt/cellphenotyper/singularity
COPY tests /opt/cellphenotyper/tests

CMD ["/bin/bash"]

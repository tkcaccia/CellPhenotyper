FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG STARDIST_TF_WHEEL_URL=https://github.com/tkcaccia/CellPhenotyper/releases/download/v2.2/tensorflow-2.22.0.dev0+selfbuilt-cp311-cp311-linux_x86_64.whl

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git build-essential pkg-config \
    libcurl4-openssl-dev libssl-dev libxml2-dev libgit2-dev libicu-dev \
    libfontconfig1-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
    libharfbuzz-dev libfribidi-dev libglpk-dev \
    libopenslide0 \
    gfortran \
    openjdk-17-jre-headless \
    procps \
    libexpat1 \
    && rm -rf /var/lib/apt/lists/*

RUN MM_ARCH="$(uname -m)" && \
    if [ "${MM_ARCH}" = "x86_64" ]; then MM_PLATFORM="linux-64"; \
    elif [ "${MM_ARCH}" = "aarch64" ] || [ "${MM_ARCH}" = "arm64" ]; then MM_PLATFORM="linux-aarch64"; \
    else echo "Unsupported architecture for GPU image build: ${MM_ARCH}" >&2; exit 1; fi && \
    curl -Ls -o /tmp/micromamba.tar.bz2 "https://micro.mamba.pm/api/micromamba/${MM_PLATFORM}/latest" && \
    tar -xvjf /tmp/micromamba.tar.bz2 -C /tmp bin/micromamba && \
    install -m 0755 /tmp/bin/micromamba /usr/local/bin/micromamba && \
    rm -rf /tmp/micromamba.tar.bz2 /tmp/bin

ENV MAMBA_ROOT_PREFIX=/opt/micromamba
COPY stardist.yml /opt/stardist.yml

RUN set -euo pipefail && \
    export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 KMP_AFFINITY=disabled && \
    export LD_LIBRARY_PATH="/opt/micromamba/envs/stardist/lib:${LD_LIBRARY_PATH:-}" && \
    micromamba create -y -n stardist -f /opt/stardist.yml -c conda-forge && \
    MM_ARCH="$(uname -m)" && \
    if [ "${MM_ARCH}" = "x86_64" ]; then \
      curl -fL --retry 5 --retry-delay 2 --retry-all-errors \
        -o /tmp/tensorflow-2.22.0.dev0+selfbuilt-cp311-cp311-linux_x86_64.whl \
        "${STARDIST_TF_WHEEL_URL}" && \
      micromamba remove -y -n stardist pytorch torchvision libtorch torchvision-extra-decoders || true; \
      micromamba run -n stardist python -m pip install --no-cache-dir --upgrade pip && \
      micromamba run -n stardist pip install --no-cache-dir --force-reinstall --index-url https://download.pytorch.org/whl/cu128 torch torchvision torchaudio && \
      micromamba run -n stardist pip install --no-cache-dir --upgrade timm==1.0.24 accelerate==1.12.0 && \
      # Pre-bake StarDist runtime stack to avoid task-time pip installs.
      # TensorFlow is pinned to a source-built wheel that supports sm_120/sm_120a.
      micromamba run -n stardist pip install --no-cache-dir --upgrade \
        "numpy<2" /tmp/tensorflow-2.22.0.dev0+selfbuilt-cp311-cp311-linux_x86_64.whl stardist csbdeep imagecodecs && \
      # TensorFlow's source-built wheel expects NVIDIA CUDA libs from pip packages.
      # Keep these on image so runtime does not depend on host-side Python installs.
      micromamba run -n stardist pip install --no-cache-dir --upgrade \
        nvidia-cuda-runtime-cu12 nvidia-cublas-cu12 nvidia-cudnn-cu12 \
        nvidia-cufft-cu12 nvidia-curand-cu12 nvidia-cusolver-cu12 \
        nvidia-cusparse-cu12 nvidia-nccl-cu12 nvidia-nvjitlink-cu12 \
        nvidia-cuda-nvcc-cu12 && \
      # Precedence shim: ensure NVIDIA pip CUDA libs are resolved before older conda libs.
      mkdir -p /opt/micromamba/envs/stardist/lib/tf-nvidia && \
      for d in /opt/micromamba/envs/stardist/lib/python3.11/site-packages/nvidia/*/lib; do \
        for f in "$d"/*.so*; do \
          ln -sf "$f" /opt/micromamba/envs/stardist/lib/tf-nvidia/; \
        done; \
      done && \
      micromamba run -n stardist python -c "import tensorflow as tf, stardist, csbdeep, imagecodecs; print(f'[INFO] StarDist runtime baked: tensorflow={tf.__version__} stardist={stardist.__version__} csbdeep={csbdeep.__version__} imagecodecs={imagecodecs.__version__}')"; \
    else \
      # GB10/sm_121 needs arm64 nightly cu130 wheels; stable cu126 arm64 wheels are sm_80/sm_90 only.
      micromamba remove -y -n stardist pytorch torchvision libtorch torchvision-extra-decoders || true; \
      micromamba run -n stardist python -m pip install --no-cache-dir --upgrade pip && \
      micromamba run -n stardist pip install --no-cache-dir --force-reinstall --pre --index-url https://download.pytorch.org/whl/nightly/cu130 torch torchvision && \
      micromamba run -n stardist pip install --no-cache-dir --upgrade timm==1.0.24 accelerate==1.12.0 && \
      # Keep non-TensorFlow StarDist deps baked on arm64; TensorFlow wheel availability varies.
      micromamba run -n stardist pip install --no-cache-dir --upgrade "numpy<2" stardist csbdeep imagecodecs; \
    fi && \
    micromamba run -n stardist python -c "import torch; print(f'[INFO] PyTorch build: version={torch.__version__} cuda={torch.version.cuda}'); assert torch.backends.cuda.is_built(), 'FATAL: GPU image build produced CPU-only PyTorch'; assert torch.version.cuda, 'FATAL: GPU image build has no CUDA runtime tag in PyTorch'; print(f'[INFO] PyTorch CUDA arch list: {torch.cuda.get_arch_list()}')" && \
    for attempt in 1 2 3; do \
      if micromamba install -y -n stardist -c ome -c conda-forge bioformats2raw raw2ometiff; then \
        break; \
      fi; \
      echo "Retrying OME tool install (attempt ${attempt}) after cleaning cache..." >&2; \
      micromamba clean -a -y || true; \
      if [ "${attempt}" -eq 3 ]; then \
        exit 1; \
      fi; \
    done && \
    micromamba install -y -n stardist \
      -c conda-forge -c bioconda --channel-priority strict \
      libjpeg-turbo libtiff libvips \
      openslide openslide-python pyvips \
      rasterio affine \
      r-base r-devtools r-data.table r-irlba r-biocmanager r-remotes r-r.utils r-igraph \
      bioconductor-bluster && \
    micromamba run -n stardist python -c "import importlib; mods=['torch','timm','imagecodecs','tifffile','huggingface_hub','rasterio','pyvips','openslide']; missing=[]; exec('for m in mods:\\n    try:\\n        importlib.import_module(m)\\n    except Exception as e:\\n        missing.append(f\\\"{m}: {e}\\\")'); print('Container runtime module check passed') if not missing else (_ for _ in ()).throw(SystemExit('Missing runtime modules:\\n' + '\\n'.join(missing)))" && \
    micromamba run -n stardist Rscript -e 'devtools::install_github("xzhoulab/SPARK")' && \
    micromamba run -n stardist Rscript -e 'devtools::install_github("tkcaccia/KODAMA")' && \
    micromamba run -n stardist Rscript -e 'devtools::install_github("tkcaccia/KODAMAextra")' && \
    micromamba clean -a -y

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PATH=/opt/micromamba/envs/stardist/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/micromamba/envs/stardist/lib/tf-nvidia:/opt/micromamba/envs/stardist/lib:$LD_LIBRARY_PATH
ENV XLA_FLAGS=--xla_gpu_cuda_data_dir=/opt/micromamba/envs/stardist/lib/python3.11/site-packages/nvidia/cuda_nvcc

CMD ["/bin/bash"]

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG STARDIST_TF_WHEEL_URL=https://github.com/tkcaccia/CellPhenotyper/releases/download/v2.2/tensorflow-2.22.0.dev0+selfbuilt-cp311-cp311-linux_x86_64.whl
ARG FASTEMBEDR_REVISION=a74ce04633efe324c8137498320816a55b9fff61
ARG KODAMA_REVISION=8be4735436116a5a4b0fabb9df2d64de16e3d80e
ARG BIOCGENERICS_REVISION=32f12a9b54e4fe33dc447f3e2c488b0d91b6a61b
ARG S4VECTORS_REVISION=fc819a547a51d682f7788ae16a42c26840b1ed2f
ARG FASTPLS_REVISION=dcf45cccee8a1cb1a3ae8b3353a410ab0902162f
ARG CONCH_REVISION=141cc09c

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git build-essential pkg-config \
    libcurl4-openssl-dev libssl-dev libxml2-dev libgit2-dev libicu-dev \
    libfontconfig1-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
    libharfbuzz-dev libfribidi-dev libglpk-dev libuv1-dev \
    libopenslide0 \
    libvips42 \
    gfortran \
    openjdk-17-jre-headless \
    pandoc \
    procps \
    libexpat1 \
    && rm -rf /var/lib/apt/lists/*

RUN MM_ARCH="$(uname -m)" && \
    if [ "${MM_ARCH}" = "x86_64" ]; then MM_PLATFORM="linux-64"; \
    elif [ "${MM_ARCH}" = "aarch64" ] || [ "${MM_ARCH}" = "arm64" ]; then MM_PLATFORM="linux-aarch64"; \
    else echo "Unsupported architecture for GPU image build: ${MM_ARCH}" >&2; exit 1; fi && \
    curl -Ls -o /tmp/micromamba.tar.bz2 "https://micro.mamba.pm/api/micromamba/${MM_PLATFORM}/latest" && \
    tar -xvjf /tmp/micromamba.tar.bz2 -C /tmp bin/micromamba && \
    install -m 0755 /tmp/bin/micromamba /usr/local/bin/micromamba && \
    rm -rf /tmp/micromamba.tar.bz2 /tmp/bin

ENV MAMBA_ROOT_PREFIX=/opt/micromamba
COPY stardist.yml /opt/stardist.yml

RUN set -euo pipefail && \
    export PIP_DEFAULT_TIMEOUT=100 PIP_RETRIES=10 PIP_DISABLE_PIP_VERSION_CHECK=1 && \
    export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 KMP_AFFINITY=disabled && \
    export LD_LIBRARY_PATH="/opt/micromamba/envs/stardist/lib:${LD_LIBRARY_PATH:-}" && \
    micromamba create -y -n stardist -f /opt/stardist.yml -c conda-forge && \
    MM_ARCH="$(uname -m)" && \
    if [ "${MM_ARCH}" = "x86_64" ]; then \
      curl -fL --retry 5 --retry-delay 2 --retry-all-errors \
        -o /tmp/tensorflow-2.22.0.dev0+selfbuilt-cp311-cp311-linux_x86_64.whl \
        "${STARDIST_TF_WHEEL_URL}" && \
      micromamba remove -y -n stardist pytorch torchvision libtorch torchvision-extra-decoders || true; \
      micromamba run -n stardist python -m pip install --no-cache-dir --upgrade pip && \
      micromamba run -n stardist pip install --no-cache-dir --force-reinstall --index-url https://download.pytorch.org/whl/cu128 torch torchvision torchaudio && \
      micromamba run -n stardist pip install --no-cache-dir --upgrade timm==1.0.24 accelerate==1.12.0 && \
      # Pre-bake StarDist runtime stack to avoid task-time pip installs.
      # TensorFlow is pinned to a source-built wheel that supports sm_120/sm_120a.
      micromamba run -n stardist pip install --no-cache-dir --upgrade \
        "numpy<2" /tmp/tensorflow-2.22.0.dev0+selfbuilt-cp311-cp311-linux_x86_64.whl stardist csbdeep "imagecodecs<2025" && \
      micromamba run -n stardist pip install --no-cache-dir --upgrade rasterio affine pyvips openslide-python aicsimageio aicspylibczi && \
      # TensorFlow's source-built wheel expects NVIDIA CUDA libs from pip packages.
      # Keep these on image so runtime does not depend on host-side Python installs.
      micromamba run -n stardist pip install --no-cache-dir --upgrade \
        nvidia-cuda-runtime-cu12 nvidia-cublas-cu12 nvidia-cudnn-cu12 \
        nvidia-cufft-cu12 nvidia-curand-cu12 nvidia-cusolver-cu12 \
        nvidia-cusparse-cu12 nvidia-nccl-cu12 nvidia-nvjitlink-cu12 \
        nvidia-cuda-nvcc-cu12 && \
      # Precedence shim: ensure NVIDIA pip CUDA libs are resolved before older conda libs.
      mkdir -p /opt/micromamba/envs/stardist/lib/tf-nvidia && \
      for d in /opt/micromamba/envs/stardist/lib/python3.11/site-packages/nvidia/*/lib; do \
        for f in "$d"/*.so*; do \
          ln -sf "$f" /opt/micromamba/envs/stardist/lib/tf-nvidia/; \
        done; \
      done && \
      micromamba run -n stardist python -c "import tensorflow as tf, stardist, csbdeep, imagecodecs; print(f'[INFO] StarDist runtime baked: tensorflow={tf.__version__} stardist={stardist.__version__} csbdeep={csbdeep.__version__} imagecodecs={imagecodecs.__version__}')"; \
    else \
      # GB10/sm_121 needs arm64 nightly cu130 wheels; stable cu126 arm64 wheels are sm_80/sm_90 only.
      micromamba remove -y -n stardist pytorch torchvision libtorch torchvision-extra-decoders || true; \
      micromamba run -n stardist python -m pip install --no-cache-dir --upgrade pip && \
      micromamba run -n stardist pip install --no-cache-dir --force-reinstall --pre --index-url https://download.pytorch.org/whl/nightly/cu130 torch torchvision && \
      micromamba run -n stardist pip install --no-cache-dir --upgrade timm==1.0.24 accelerate==1.12.0 && \
      # Keep non-TensorFlow StarDist deps baked on arm64; TensorFlow wheel availability varies.
      micromamba run -n stardist pip install --no-cache-dir --upgrade "numpy<2" stardist csbdeep "imagecodecs<2025" rasterio affine pyvips openslide-python aicsimageio aicspylibczi; \
    fi && \
    micromamba run -n stardist python -c "import torch; print(f'[INFO] PyTorch build: version={torch.__version__} cuda={torch.version.cuda}'); assert torch.backends.cuda.is_built(), 'FATAL: GPU image build produced CPU-only PyTorch'; assert torch.version.cuda, 'FATAL: GPU image build has no CUDA runtime tag in PyTorch'; print(f'[INFO] PyTorch CUDA arch list: {torch.cuda.get_arch_list()}')" && \
    for attempt in 1 2 3; do \
      if micromamba install -y -n stardist -c ome -c conda-forge bioformats2raw raw2ometiff; then \
        break; \
      fi; \
      echo "Retrying OME tool install (attempt ${attempt}) after cleaning cache..." >&2; \
      micromamba clean -a -y || true; \
      if [ "${attempt}" -eq 3 ]; then \
        exit 1; \
      fi; \
    done && \
    micromamba install -y -n stardist \
      -c conda-forge -c bioconda --channel-priority strict \
      r-base r-devtools r-data.table r-irlba r-biocmanager r-remotes r-r.utils r-igraph r-umap \
      r-rann r-rcpparmadillo r-rcpphnsw r-rcppannoy r-uwot \
      bioconductor-biocneighbors bioconductor-bluster && \
    mkdir -p /root/.R && \
    printf '%s\n' 'CXX11STD=-std=gnu++14' 'CXX14STD=-std=gnu++14' > /root/.R/Makevars && \
    micromamba run -n stardist python -c "import importlib; mods=['torch','timm','imagecodecs','tifffile','huggingface_hub','rasterio','pyvips','openslide','aicsimageio','aicspylibczi']; missing=[]; exec('for m in mods:\\n    try:\\n        importlib.import_module(m)\\n    except Exception as e:\\n        missing.append(f\\\"{m}: {e}\\\")'); print('Container runtime module check passed') if not missing else (_ for _ in ()).throw(SystemExit('Missing runtime modules:\\n' + '\\n'.join(missing)))" && \
    micromamba run -n stardist pip install --no-cache-dir ftfy regex tokenizers && \
    micromamba run -n stardist pip install --no-cache-dir --no-deps \
      "git+https://github.com/Mahmoodlab/CONCH.git@${CONCH_REVISION}" && \
    micromamba run -n stardist python -c "import conch; from transformers import AutoModel; print('TITAN/CONCH runtime check passed')" && \
    micromamba run -n stardist Rscript -e 'devtools::install_github("xzhoulab/SPARK")' && \
    micromamba create -y -n kodama-r -c conda-forge -c bioconda --channel-priority strict \
      'r-base>=4.6' zlib libuv && \
    micromamba run -n kodama-r Rscript -e 'stopifnot(getRversion() >= "4.6.0"); install.packages(c("Rcpp", "withr", "generics", "data.table", "R.utils", "remotes", "Matrix", "float", "RcppArmadillo", "RcppEigen", "ggplot2", "rmarkdown"), repos="https://cloud.r-project.org", Ncpus=4L)' && \
    micromamba run -n kodama-r Rscript -e "remotes::install_github('tkcaccia/fastPLS@${FASTPLS_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n kodama-r Rscript -e "remotes::install_github('Bioconductor/BiocGenerics@${BIOCGENERICS_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n kodama-r Rscript -e "remotes::install_github('Bioconductor/S4Vectors@${S4VECTORS_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n kodama-r Rscript -e "remotes::install_github('tkcaccia/fastEmbedR@${FASTEMBEDR_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n kodama-r Rscript -e "remotes::install_github('tkcaccia/KODAMA@${KODAMA_REVISION}', dependencies=FALSE, upgrade='never')" && \
    micromamba run -n stardist Rscript -e 'install.packages("Rnanoflann", repos="https://cloud.r-project.org")' && \
    micromamba run -n kodama-r Rscript -e 'stopifnot(getRversion() >= "4.6.0", packageVersion("fastEmbedR") >= "0.99.5", packageVersion("KODAMA") == "0.99.7"); library(KODAMA); library(fastEmbedR); library(data.table); cat("KODAMA R 4.6 runtime check passed\n")' && \
    micromamba run -n stardist Rscript -e 'library(SPARK); library(BiocNeighbors); library(RANN); library(Rnanoflann); library(RcppHNSW); library(RcppAnnoy); library(uwot); cat("General R runtime package check passed\n")' && \
    micromamba run -n kodama-r Rscript -e 'stopifnot(getRversion() >= "4.6.0"); library(fastPLS); library(ggplot2); library(rmarkdown); cat("PathoFMPred R 4.6 dependency check passed\n")' && \
    micromamba clean -a -y

WORKDIR /opt/cellphenotyper
COPY main.nf nextflow.config pipeline_paramers.yml README.md PARAMETERS.md OUTPUT.md INSTALL.md RELEASE.md TROUBLESHOOTING.md TUTORIAL.md LINUX_UPDATE.md /opt/cellphenotyper/
COPY bin /opt/cellphenotyper/bin
COPY modules /opt/cellphenotyper/modules
COPY subworkflows /opt/cellphenotyper/subworkflows
COPY docker /opt/cellphenotyper/docker
COPY examples /opt/cellphenotyper/examples
COPY singularity /opt/cellphenotyper/singularity
RUN mkdir -p /opt/cellphenotyper/third_party && \
    git clone --depth 1 https://github.com/bowang-lab/MedSAM /opt/cellphenotyper/third_party/MedSAM && \
    git clone --depth 1 https://github.com/vqdang/hover_net /opt/cellphenotyper/third_party/hover_net && \
    mkdir -p /opt/cellphenotyper/models/hovernet && \
    micromamba run -n stardist pip install --no-cache-dir "numpy<2" "opencv-python-headless<4.12" \
      gdown docopt future psutil "scikit-learn<1.8" tensorboardX termcolor && \
    micromamba run -n stardist pip install --no-cache-dir --no-deps imgaug==0.4.0 && \
    micromamba run -n stardist gdown 13qkxDqv7CUqxN-l5CpeFVmc24mDw6CeV \
      -O /opt/cellphenotyper/models/hovernet/hovernet_fast_monusac_type_tf2pytorch.tar && \
    micromamba create -y -n cellvit python=3.11 pip && \
    CELLVIT_ARCH="$(uname -m)" && \
    if [ "${CELLVIT_ARCH}" = "x86_64" ]; then \
      micromamba run -n cellvit pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 torch torchvision; \
    else \
      micromamba run -n cellvit pip install --no-cache-dir --pre --index-url https://download.pytorch.org/whl/nightly/cu130 torch torchvision; \
    fi && \
    micromamba run -n cellvit pip install --no-cache-dir cellvit==1.0.9 && \
    mkdir -p /opt/cellphenotyper/models/cellvit && \
    CELLVIT_CACHE=/opt/cellphenotyper/models/cellvit micromamba run -n cellvit python -c "from cellvit.utils.cache_models import cache_cellvit_256, cache_classifier; cache_cellvit_256(); cache_classifier()" && \
    micromamba run -n cellvit cellvit-inference --help >/dev/null && \
    mkdir -p /opt/cellphenotyper/third_party/grandqc/pydeps /opt/cellphenotyper/third_party/grandqc/models/td /opt/cellphenotyper/third_party/grandqc/models/qc && \
    mkdir -p /opt/cellphenotyper/third_party/MedSAM/work_dir/MedSAM && \
    wget -q -O /opt/cellphenotyper/third_party/MedSAM/work_dir/MedSAM/medsam_vit_b.pth "https://zenodo.org/records/10689643/files/medsam_vit_b.pth?download=1" && \
    micromamba run -n stardist python -m pip install --no-cache-dir --upgrade \
      --target /opt/cellphenotyper/third_party/grandqc/pydeps \
      -r /opt/cellphenotyper/docker/requirements.grandqc.base.txt && \
    micromamba run -n stardist python -m pip install --no-cache-dir --upgrade --no-deps \
      --target /opt/cellphenotyper/third_party/grandqc/pydeps \
      -r /opt/cellphenotyper/docker/requirements.grandqc.infer.txt && \
    wget -q -O /opt/cellphenotyper/third_party/grandqc/models/td/Tissue_Detection_MPP10.pth "https://zenodo.org/records/14507273/files/Tissue_Detection_MPP10.pth?download=1" && \
    wget -q -O /opt/cellphenotyper/third_party/grandqc/models/qc/GrandQC_MPP1.pth "https://zenodo.org/records/14041538/files/GrandQC_MPP1.pth?download=1" && \
    wget -q -O /opt/cellphenotyper/third_party/grandqc/models/qc/GrandQC_MPP15.pth "https://zenodo.org/records/14041538/files/GrandQC_MPP15.pth?download=1" && \
    wget -q -O /opt/cellphenotyper/third_party/grandqc/models/qc/GrandQC_MPP2.pth "https://zenodo.org/records/14041538/files/GrandQC_MPP2.pth?download=1" && \
    printf '%s\n' 'GrandQC bundled runtime' 'License: CC BY-NC-SA 4.0' 'Source: https://github.com/cpath-ukk/grandqc' 'Paper DOI: 10.1038/s41467-024-54769-y' > /opt/cellphenotyper/third_party/grandqc/NOTICE.txt && \
    env PYTHONPATH=/opt/cellphenotyper/third_party/grandqc/pydeps micromamba run -n stardist python -c "import importlib; mods=['cv2','numpy','PIL','tifffile','zarr','numcodecs','skimage','imagecodecs','segmentation_models_pytorch','timm','pretrainedmodels','efficientnet_pytorch']; missing=[]; exec('for m in mods:\\n    try:\\n        importlib.import_module(m)\\n    except Exception as e:\\n        missing.append(f\\\"{m}: {e}\\\")'); print('GrandQC bundled runtime check passed') if not missing else (_ for _ in ()).throw(SystemExit('GrandQC bundled runtime check failed:\\n' + '\\n'.join(missing)))" && \
    chmod -R a+rX /opt/cellphenotyper/third_party/grandqc && \
    chmod -R a+rX /opt/cellphenotyper/third_party/MedSAM

RUN mkdir -p /opt/cellphenotyper/empty-r-library

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PATH=/opt/micromamba/envs/stardist/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/micromamba/envs/stardist/lib/tf-nvidia:/opt/micromamba/envs/stardist/lib
ENV XLA_FLAGS=--xla_gpu_cuda_data_dir=/opt/micromamba/envs/stardist/lib/python3.11/site-packages/nvidia/cuda_nvcc
ENV CELLPHENOTYPER_HOME=/opt/cellphenotyper
ENV GRANDQC_HOME=/opt/cellphenotyper/third_party/grandqc
ENV MEDSAM_REPO_DIR=/opt/cellphenotyper/third_party/MedSAM
ENV MEDSAM_CHECKPOINT=/opt/cellphenotyper/third_party/MedSAM/work_dir/MedSAM/medsam_vit_b.pth
ENV HOVERNET_REPO_DIR=/opt/cellphenotyper/third_party/hover_net
ENV HOVERNET_MONUSAC_CHECKPOINT=/opt/cellphenotyper/models/hovernet/hovernet_fast_monusac_type_tf2pytorch.tar
ENV CELLVIT_EXECUTABLE=/opt/micromamba/envs/cellvit/bin/cellvit-inference
ENV R_LIBS_USER=/opt/cellphenotyper/empty-r-library
ENV R_ENVIRON_USER=/dev/null
ENV R_PROFILE_USER=/dev/null

CMD ["/bin/bash"]

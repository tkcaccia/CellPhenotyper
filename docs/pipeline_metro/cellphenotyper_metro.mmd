graph LR
    subgraph input_crop [1 · Image intake and tissue selection]
        %%metro direction: LR
        %%metro grid: input_crop | 0,0,2,1
        input_image([H&E whole-slide image])
        prepare_ometiff([MPP-aware OME-TIFF])
        grandqc([GrandQC tissue and artifact mask])
        whole_crop([Crop to usable tissue])
        roi_crop([ROI GeoJSON: crop to usable tissue ∩ ROI])
        tissue_gate([Unified analysis crop])
        route_split([Route selection])

        input_image -->|source| prepare_ometiff
        prepare_ometiff -->|source| grandqc
        grandqc -->|whole_tissue| whole_crop
        grandqc -->|roi_tissue| roi_crop
        whole_crop -->|whole_tissue| tissue_gate
        roi_crop -->|roi_tissue| tissue_gate
        tissue_gate -->|analysis| route_split
    end

    subgraph pathway_a [2A · Pathway A — tissue-domain morphology]
        %%metro direction: LR
        %%metro grid: pathway_a | 1,0,1,2
        grid_tiling([Overlapping grid; adjacent inner cores])
        grid_uni2([UNI-2: tile + inner-centre features])
        grid_kodama([Grid PCA + KODAMA])
        grid_leiden([Grid Leiden phenotypes])

        grid_tiling -->|tissue_grid| grid_uni2
        grid_uni2 -->|tissue_grid| grid_kodama
        grid_kodama -->|tissue_grid| grid_leiden
    end

    subgraph pathway_b_detection [2B · Pathway B — parallel cell detection]
        %%metro direction: LR
        %%metro grid: pathway_b_detection | 1,1,1,1
        %%metro exit: right | cell_morphology
        stardist([StarDist])
        hovernet([HoVer-Net MoNuSAC])
        cellvitpp([CellViT++])
        consensus([Role-aware instance fusion])
        cell_route([Cell morphology])
        gigatime([GigaTIME virtual mIHC])
        marker_quantification([Nuclear + cell-region marker quantification])
        marker_kodama([Marker PCA + KODAMA])

        stardist -->|stardist_cells| consensus
        hovernet -->|monusac_cells| consensus
        cellvitpp -->|cellvit_cells| consensus
        consensus -->|cell_morphology| cell_route
        consensus -->|virtual_markers| gigatime
        gigatime -->|virtual_markers| marker_quantification
        marker_quantification -->|virtual_markers| marker_kodama
    end

    subgraph pathway_b_cell_features [3B1 · Cell-centred morphology]
        %%metro direction: LR
        %%metro grid: pathway_b_cell_features | 2,1,1,1
        %%metro entry: left | cell_morphology
        cell_tiling([Cell-centred tiles])
        cell_uni2([UNI-2: tile + 90 px inner-square])
        cell_kodama([Cell PCA + KODAMA])
        cell_leiden([Cell Leiden phenotypes])

        cell_tiling -->|cell_morphology| cell_uni2
        cell_uni2 -->|cell_morphology| cell_kodama
        cell_kodama -->|cell_morphology| cell_leiden
    end

    subgraph tissue_segmentation [4 · Tissue phenotype reconstruction]
        %%metro direction: LR
        %%metro grid: tissue_segmentation | 3,0,2,1
        morphology_labels([Morphology phenotype labels])
        cell_cluster_mask([Rasterize cell phenotypes])
        grid_cluster_mask([Rasterize grid phenotypes])
        grow_to_tissue([Grow sparse cell labels through tissue])
        medsam([GPU MedSAM boundary refinement])
        cluster_geojson([Tissue phenotype GeoJSON])

        morphology_labels -->|cell_morphology| cell_cluster_mask
        morphology_labels -->|tissue_grid| grid_cluster_mask
        cell_cluster_mask -->|cell_morphology| grow_to_tissue
        grow_to_tissue -->|cell_morphology| medsam
        grid_cluster_mask -->|tissue_grid| medsam
        medsam -->|cell_morphology,tissue_grid| cluster_geojson
    end

    subgraph optional_interpretation [5 · Optional section-level interpretation]
        %%metro direction: LR
        %%metro grid: optional_interpretation | 4,0,2,1
        neoplastic_section([Select neoplastic-enriched section])
        titan([CONCH features + TITAN])
        pathofmpred([PathoFMPred])

        neoplastic_section -->|section_models| titan
        titan -->|section_models| pathofmpred
    end

    route_split -->|tissue_grid| grid_tiling
    route_split -->|stardist_cells| stardist
    route_split -->|monusac_cells| hovernet

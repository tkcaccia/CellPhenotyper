nextflow.enable.dsl = 2

def default_container_repo = 'ghcr.io/tkcaccia/cellphenotyper'
def default_container_cpu_tag = '0.2.0'
def default_container_cpu_tag_amd64 = '0.2.0-amd64'
def default_container_cpu_tag_arm64 = '0.2.0'
def default_container_gpu_tag = '0.2.0-gpu'

params {
  image_input                    = null
  roi_geojson                    = null
  outdir_base                    = 'results'

  run_full_pipeline              = true
  start_point                    = 'convert'
  end_point                      = 'auto'
  tissue_mask_from_input         = false
  compute_device                 = 'cpu'   // cpu | gpu | auto
  host_arch                      = 'auto'  // auto | amd64 | arm64
  runtime_image_mode             = 'auto'  // auto | manual
  uni2_device_auto               = 'cpu'

  container_repo                 = default_container_repo
  container_cpu_tag              = default_container_cpu_tag   // legacy generic fallback; arch tags below are authoritative
  container_cpu_tag_amd64        = default_container_cpu_tag_amd64
  container_cpu_tag_arm64        = default_container_cpu_tag_arm64
  container_gpu_tag              = default_container_gpu_tag
  singularity_image_source       = 'auto'   // auto | release | docker (release falls back to docker if asset is missing)
  singularity_release_repo       = 'tkcaccia/CellPhenotyper'
  singularity_release_tag        = 'v0.2.0'
  singularity_cpu_asset_amd64    = 'cellphenotyper-0.2.0-amd64.sif'
  singularity_cpu_asset_arm64    = 'cellphenotyper-0.2.0-arm64.sif'
  singularity_gpu_asset_amd64    = 'cellphenotyper-0.2.0-gpu-amd64.sif'
  singularity_local_dir          = ''       // optional local directory containing prebuilt *.sif assets

  singularity_image              = ''
  docker_image                   = ''

  max_cpus                       = Runtime.runtime.availableProcessors()
  max_memory_gb                  = 64

  btf_converter_script           = 'bin/convert_btf_to_ometiff.sh'
  convert_compression            = 'LZW'
  convert_downsample             = 'GAUSSIAN'
  convert_rgb                    = true
  convert_overwrite              = true
  convert_cpus                   = 8
  convert_memory_gb              = 16
  convert_time                   = '6h'

  stardist_script                = 'bin/run_stardist_roi_segmentation.py'
  stardist_pythonpath            = ''
  stardist_model                 = '2D_versatile_he'
  stardist_prob                  = 0.52
  stardist_nms                   = 0.28
  stardist_min_area              = 120
  stardist_tiles_x               = 32
  stardist_tiles_y               = 32
  stardist_crop_pad              = 0
  stardist_autoinstall_runtime   = true
  stardist_tensorflow_version    = '2.20.0'
  stardist_precomputed_labels_full = ''
  write_full_labels              = true
  full_format                    = 'tif'
  allow_huge_tif                 = true
  stardist_cpus                  = 16
  stardist_memory_gb             = 48
  stardist_time                  = '24h'

  tissue_mask_script             = 'bin/build_tissue_mask.py'
  tissue_work_downsample         = 8
  tissue_auto_no_downsample_max_side = 1024
  tissue_preview_factor          = 10
  tissue_close_radius            = 12
  tissue_min_obj_area            = 30000
  tissue_hole_area               = 30000
  tissue_keep_largest            = true
  tissue_tile                    = 512
  tissue_compression             = 'deflate'
  tissue_bigtiff                 = true
  tissue_mask_cpus               = 8
  tissue_mask_memory_gb          = 16
  tissue_mask_time               = '6h'

  assign_script                  = 'bin/map_cells_to_roi_polygons.py'
  assign_label_prop              = 'name'
  assign_out_col                 = 'polygon_label'
  assign_choose                  = 'smallest'
  assign_chunk_rows              = 20000
  assign_xcol                    = null
  assign_ycol                    = null
  assign_cpus                    = 12
  assign_memory_gb               = 24
  assign_time                    = '6h'

  expand_script                  = 'bin/expand_labels_to_cytoplasm.py'
  expand_px                      = 12
  expand_full_labels             = true
  expand_mode                    = 'auto'
  expand_tile_size               = 2048
  expand_auto_threshold_mpix     = 25.0
  expand_preview_factor          = 10
  expand_preview_threshold_mb    = 100.0
  expand_preview_alpha           = 0.45
  expand_compression             = 'zlib'
  expand_cpus                    = 8
  expand_memory_gb               = 16
  expand_time                    = '4h'

  uni2_script                    = 'bin/extract_uni2_embeddings.py'
  uni2_include_nuclei            = true
  uni2_include_cyto              = true
  uni2_include_inner_square      = true
  uni2_image_level               = 0
  uni2_force_full_image          = false
  uni2_grid                      = '10x10'
  uni2_tile_size                 = 224
  uni2_save_tiles                = true
  uni2_tiles_root                = 'tiles'
  uni2_bucket_size               = 5000
  uni2_min_area                  = 0
  uni2_mask_context_mode         = 'label' // none | label | inner_square | label_and_inner_square
  uni2_inner_square_factor       = 1.0
  uni2_inner_square_min_px       = 32
  uni2_inner_square_max_px       = 0
  uni2_inner_square_fixed_px     = 90
  uni2_encoder                   = 'uni2-h'
  uni2_backend                   = 'auto'
  uni2_pooling                   = 'auto'
  uni2_img_size                  = 224
  uni2_batch                     = 64
  uni2_torch_threads             = 16
  uni2_rows_per_csv              = 10000
  uni2_mask_block                = 4096
  uni2_cpus                      = 16
  uni2_memory_gb                 = 48
  uni2_time                      = '24h'

  hf_home                        = "${baseDir}/.hf_cache"
  hf_hub_cache                   = "${baseDir}/.hf_cache/hub"
  hf_token_env_file              = ''
  hf_token_env_var_name          = 'HF_TOKEN'

  r_data_loader_script           = 'bin/load_kodama_rawdata.R'
  r_script                       = 'bin/run_kodama_analysis.R'
  kodama_embedding_mode          = 'all'
  kodama_dims_to_run             = 20
  kodama_spark_top_features      = 100
  kodama_n_cores                 = 4
  r_cpus                         = 8
  r_memory_gb                    = 24
  r_time                         = '8h'

  cluster_r_script               = 'bin/Rcode_Clustering.R'
  cluster_kodama_dim             = 20
  cluster_snn_k                  = 10
  cluster_resolution             = 'auto'
  cluster_target_n               = 0
  cluster_annotation_guided      = false
  cluster_annotation_only        = false
  cluster_annotation_col         = 'polygon_label'
  cluster_annotation_ari_margin  = 0.01
  cluster_cpus                   = 8
  cluster_memory_gb              = 24
  cluster_time                   = '8h'

  cluster_mask_script            = 'bin/labels_to_cluster_mask.py'
  cluster_mask_default_value     = 0
  cluster_mask_compression       = 'none'
  cluster_mask_preview_factor    = 10
  cluster_mask_preview_threshold_mb = 100.0
  cluster_mask_preview_alpha     = 0.45
  cluster_mask_cpus              = 8
  cluster_mask_memory_gb         = 16
  cluster_mask_time              = '6h'

  grow_script                    = 'bin/grow_to_tissue.py'
  grow_preview_factor            = 10
  grow_preview_threshold_mb      = 100.0
  grow_preview_alpha             = 0.45
  grow_sigma                     = 1.0
  grow_restrict_to_seeded_components = true
  grow_min_seed_area             = 200
  grow_fill_holes_area           = 50000
  grow_close_radius              = 12
  grow_add_nuclei                = true
  grow_nuclei_thresh             = 170
  grow_nuclei_dilate             = 2
  grow_pyr_compression           = 'LZW'
  grow_max_workers               = 16
  grow_downsample                = 'GAUSSIAN'
  grow_legacy                    = false
  grow_overwrite                 = true
  grow_keep_tmp                  = false
  grow_cpus                      = 12
  grow_memory_gb                 = 32
  grow_time                      = '12h'

  cluster_geojson_script         = 'bin/mask_to_geojson.py'
  cluster_geojson_page           = 0
  cluster_geojson_dissolve_by_value = true
  cluster_geojson_min_area       = 500
  cluster_geojson_smooth_buffer  = 10.0
  cluster_geojson_smooth_passes  = 3
  cluster_geojson_simplify       = 6.0
  cluster_geojson_fill_holes     = true
  cluster_geojson_preserve_topology = true
  cluster_geojson_group_map      = ''
  cluster_geojson_group_prefix   = 'color_'
  cluster_geojson_cpus           = 8
  cluster_geojson_memory_gb      = 16
  cluster_geojson_time           = '6h'
}

process {
  executor = 'local'
  shell = ['/bin/bash', '-euo', 'pipefail']

  withLabel: io_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_medium {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
}

profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.runOptions = params.compute_device == 'gpu' ? '--nv' : ''
    process.container = {
      def normalizeArch = { raw ->
        def value = (raw ?: '').toString().trim().toLowerCase()
        if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
        if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
        if (value == 'auto') return 'auto'
        return value
      }

      def runtimeMode = (params.get('runtime_image_mode', 'auto') ?: 'auto').toString().trim().toLowerCase()
      if (!(runtimeMode in ['auto', 'manual'])) runtimeMode = 'auto'

      def manualImage = (params.get('singularity_image', '') ?: '').toString().trim()
      if (runtimeMode == 'manual' && manualImage) {
        return manualImage
      }

      def hostArch = normalizeArch(params.get('host_arch', 'auto'))
      if (!hostArch || hostArch == 'auto') {
        hostArch = normalizeArch(System.getProperty('os.arch'))
      }
      if (!(hostArch in ['amd64', 'arm64'])) {
        hostArch = 'amd64'
      }

      def computeDevice = (params.get('compute_device', 'cpu') ?: 'cpu').toString().trim().toLowerCase()
      if (!(computeDevice in ['cpu', 'gpu', 'auto'])) computeDevice = 'cpu'
      if (computeDevice == 'auto') computeDevice = 'cpu'

      def repo = (params.get('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
      if (!repo) repo = default_container_repo

      def cpuTagGeneric = (params.get('container_cpu_tag', default_container_cpu_tag) ?: default_container_cpu_tag).toString().trim()
      if (!cpuTagGeneric) cpuTagGeneric = default_container_cpu_tag
      def cpuTagAmd64 = (params.get('container_cpu_tag_amd64', '') ?: '').toString().trim()
      if (!cpuTagAmd64) cpuTagAmd64 = '0.2.0-amd64'
      def cpuTagArm64 = (params.get('container_cpu_tag_arm64', '') ?: '').toString().trim()
      if (!cpuTagArm64) cpuTagArm64 = '0.2.0'
      def gpuTag = (params.get('container_gpu_tag', default_container_gpu_tag) ?: default_container_gpu_tag).toString().trim()
      if (!gpuTag) gpuTag = default_container_gpu_tag

      def selectedCpuTag = hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64
      def selectedTag = computeDevice == 'gpu' ? gpuTag : selectedCpuTag
      def dockerRef = "docker://${repo}:${selectedTag}"

      def sourceMode = (params.get('singularity_image_source', 'auto') ?: 'auto').toString().trim().toLowerCase()
      if (!(sourceMode in ['release', 'auto', 'docker'])) sourceMode = 'auto'
      if (sourceMode == 'docker') {
        return dockerRef
      }

      def releaseRepo = (params.get('singularity_release_repo', 'tkcaccia/CellPhenotyper') ?: 'tkcaccia/CellPhenotyper').toString().trim()
      def releaseTag = (params.get('singularity_release_tag', 'v0.2.0') ?: 'v0.2.0').toString().trim()
      def cpuAssetAmd64 = (params.get('singularity_cpu_asset_amd64', 'cellphenotyper-0.2.0-amd64.sif') ?: 'cellphenotyper-0.2.0-amd64.sif').toString().trim()
      def cpuAssetArm64 = (params.get('singularity_cpu_asset_arm64', 'cellphenotyper-0.2.0-arm64.sif') ?: 'cellphenotyper-0.2.0-arm64.sif').toString().trim()
      def gpuAssetAmd64 = (params.get('singularity_gpu_asset_amd64', 'cellphenotyper-0.2.0-gpu-amd64.sif') ?: 'cellphenotyper-0.2.0-gpu-amd64.sif').toString().trim()

      def selectedAsset = computeDevice == 'gpu' ? gpuAssetAmd64 : (hostArch == 'amd64' ? cpuAssetAmd64 : cpuAssetArm64)
      if (!releaseRepo || !releaseTag || !selectedAsset) {
        return dockerRef
      }

      def localDir = (params.get('singularity_local_dir', '') ?: '').toString().trim()
      def localCandidates = []
      if (localDir) localCandidates << new File(localDir, selectedAsset)
      localCandidates << new File(baseDir.toString(), selectedAsset)
      localCandidates << new File(baseDir.toString(), "singularity/${selectedAsset}")
      for (f in localCandidates) {
        try {
          if (f.exists() && f.isFile()) return f.absolutePath
        } catch (Throwable ignored) {}
      }

      def releaseUrl = "https://github.com/${releaseRepo}/releases/download/${releaseTag}/${selectedAsset}"
      if (sourceMode in ['auto', 'release']) {
        try {
          def escaped = releaseUrl.replace("'", "'\"'\"'")
          def proc = ['bash', '-lc', "curl -fsIL --max-time 12 '${escaped}' >/dev/null 2>&1"].execute()
          def finished = proc.waitFor(3, java.util.concurrent.TimeUnit.SECONDS)
          if (!finished) {
            proc.destroyForcibly()
            return dockerRef
          }
          if (proc.exitValue() != 0) {
            return dockerRef
          }
        } catch (Throwable ignored) {
          return dockerRef
        }
      }

      return releaseUrl
    }
  }

  docker {
    docker.enabled = true
    docker.runOptions = params.compute_device == 'gpu' ? '--gpus all' : ''
    process.container = {
      def normalizeArch = { raw ->
        def value = (raw ?: '').toString().trim().toLowerCase()
        if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
        if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
        if (value == 'auto') return 'auto'
        return value
      }

      def runtimeMode = (params.get('runtime_image_mode', 'auto') ?: 'auto').toString().trim().toLowerCase()
      if (!(runtimeMode in ['auto', 'manual'])) runtimeMode = 'auto'

      def manualImage = (params.get('docker_image', '') ?: '').toString().trim()
      if (runtimeMode == 'manual' && manualImage && manualImage != 'cellphenotyper:full-cpu') {
        return manualImage
      }

      def hostArch = normalizeArch(params.get('host_arch', 'auto'))
      if (!hostArch || hostArch == 'auto') {
        hostArch = normalizeArch(System.getProperty('os.arch'))
      }
      if (!(hostArch in ['amd64', 'arm64'])) {
        hostArch = 'amd64'
      }

      def computeDevice = (params.get('compute_device', 'cpu') ?: 'cpu').toString().trim().toLowerCase()
      if (!(computeDevice in ['cpu', 'gpu', 'auto'])) computeDevice = 'cpu'
      if (computeDevice == 'auto') computeDevice = 'cpu'

      def repo = (params.get('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
      if (!repo) repo = default_container_repo

      def cpuTagGeneric = (params.get('container_cpu_tag', default_container_cpu_tag) ?: default_container_cpu_tag).toString().trim()
      if (!cpuTagGeneric) cpuTagGeneric = default_container_cpu_tag
      def cpuTagAmd64 = (params.get('container_cpu_tag_amd64', '') ?: '').toString().trim()
      if (!cpuTagAmd64) cpuTagAmd64 = '0.2.0-amd64'
      def cpuTagArm64 = (params.get('container_cpu_tag_arm64', '') ?: '').toString().trim()
      if (!cpuTagArm64) cpuTagArm64 = '0.2.0'
      def gpuTag = (params.get('container_gpu_tag', default_container_gpu_tag) ?: default_container_gpu_tag).toString().trim()
      if (!gpuTag) gpuTag = default_container_gpu_tag

      def selectedCpuTag = hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64
      def selectedTag = computeDevice == 'gpu' ? gpuTag : selectedCpuTag
      return "${repo}:${selectedTag}"
    }
  }

  debug {
    params {
      run_full_pipeline = false
      tissue_mask_from_input = true
      write_full_labels = false
      convert_cpus = 2
      tissue_mask_cpus = 2
    }
    process {
      withLabel: io_heavy {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_medium {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_heavy {
        cpus = 2
        memory = '8 GB'
        time = '2h'
      }
    }
  }
}

manifest {
  name = 'tkcaccia/CellPhenotyper'
  mainScript = 'main.nf'
  defaultBranch = 'main'
}

report {
  enabled = true
  file = "${params.outdir_base}/report_pipeline.html"
  overwrite = true
}

trace {
  enabled = true
  file = "${params.outdir_base}/00_execution/trace.tsv"
  overwrite = true
}

timeline {
  enabled = true
  file = "${params.outdir_base}/00_execution/timeline.html"
  overwrite = true
}

dag {
  enabled = true
  file = "${params.outdir_base}/00_execution/dag.html"
  overwrite = true
}

nextflow.enable.dsl = 2

def default_container_repo = 'ghcr.io/tkcaccia/cellphenotyper'
def default_container_cpu_tag = '0.2.0'
def default_container_cpu_tag_amd64 = '0.2.0'
def default_container_cpu_tag_arm64 = '0.2.0'
def default_container_gpu_tag = '0.2.0-gpu'

params {
  image_input                    = null
  roi_geojson                    = null
  outdir_base                    = 'results'

  run_full_pipeline              = true
  start_point                    = 'convert'
  end_point                      = 'auto'
  tissue_mask_from_input         = false
  compute_device                 = 'auto'  // cpu | gpu | auto
  host_arch                      = 'auto'  // auto | amd64 | arm64
  runtime_image_mode             = 'auto'  // auto | manual
  uni2_device_auto               = 'cpu'

  container_repo                 = default_container_repo
  container_cpu_tag              = default_container_cpu_tag
  container_cpu_tag_amd64        = default_container_cpu_tag_amd64
  container_cpu_tag_arm64        = default_container_cpu_tag_arm64
  container_gpu_tag              = default_container_gpu_tag

  singularity_image              = ''
  docker_image                   = ''

  max_cpus                       = Runtime.runtime.availableProcessors()
  max_memory_gb                  = 64

  btf_converter_script           = 'bin/convert_btf_to_ometiff.sh'
  convert_compression            = 'LZW'
  convert_downsample             = 'GAUSSIAN'
  convert_rgb                    = true
  convert_overwrite              = true
  convert_cpus                   = 8
  convert_memory_gb              = 16
  convert_time                   = '6h'

  stardist_script                = 'bin/run_stardist_roi_segmentation.py'
  stardist_pythonpath            = ''
  stardist_model                 = '2D_versatile_he'
  stardist_prob                  = 0.48
  stardist_nms                   = 0.30
  stardist_tiles_x               = 32
  stardist_tiles_y               = 32
  stardist_precomputed_labels_full = ''
  write_full_labels              = true
  full_format                    = 'tif'
  allow_huge_tif                 = true
  stardist_cpus                  = 16
  stardist_memory_gb             = 48
  stardist_time                  = '24h'

  tissue_mask_script             = 'bin/build_tissue_mask.py'
  tissue_work_downsample         = 8
  tissue_preview_factor          = 10
  tissue_close_radius            = 12
  tissue_min_obj_area            = 30000
  tissue_hole_area               = 30000
  tissue_keep_largest            = true
  tissue_tile                    = 512
  tissue_compression             = 'deflate'
  tissue_bigtiff                 = true
  tissue_mask_cpus               = 8
  tissue_mask_memory_gb          = 16
  tissue_mask_time               = '6h'

  tissue_geojson_script          = 'bin/convert_tissue_mask_to_geojson.py'
  tissue_geojson_page            = 0
  tissue_geojson_binary          = true
  tissue_geojson_dissolve        = true
  tissue_geojson_dissolve_by_value = false
  tissue_geojson_min_area        = 2500
  tissue_geojson_smooth_buffer   = 6
  tissue_geojson_smooth_passes   = 2
  tissue_geojson_simplify        = 2
  tissue_geojson_preserve_topology = true
  tissue_geojson_fill_holes      = true
  tissue_geojson_cpus            = 8
  tissue_geojson_memory_gb       = 16
  tissue_geojson_time            = '6h'

  assign_script                  = 'bin/map_cells_to_roi_polygons.py'
  assign_label_prop              = 'name'
  assign_out_col                 = 'polygon_label'
  assign_choose                  = 'smallest'
  assign_chunk_rows              = 20000
  assign_xcol                    = null
  assign_ycol                    = null
  assign_cpus                    = 12
  assign_memory_gb               = 24
  assign_time                    = '6h'

  expand_script                  = 'bin/expand_labels_to_cytoplasm.py'
  expand_px                      = 12
  expand_full_labels             = true
  expand_mode                    = 'auto'
  expand_tile_size               = 2048
  expand_auto_threshold_mpix     = 25.0
  expand_compression             = 'zlib'
  expand_cpus                    = 8
  expand_memory_gb               = 16
  expand_time                    = '4h'

  uni2_script                    = 'bin/extract_uni2_embeddings.py'
  uni2_include_cyto              = true
  uni2_image_level               = 0
  uni2_force_full_image          = true
  uni2_grid                      = '10x10'
  uni2_tile_size                 = 224
  uni2_save_tiles                = true
  uni2_tiles_root                = 'tiles'
  uni2_bucket_size               = 5000
  uni2_min_area                  = 0
  uni2_encoder                   = 'uni2-h'
  uni2_backend                   = 'auto'
  uni2_pooling                   = 'auto'
  uni2_img_size                  = 224
  uni2_batch                     = 64
  uni2_torch_threads             = 16
  uni2_rows_per_csv              = 10000
  uni2_mask_block                = 4096
  uni2_cpus                      = 16
  uni2_memory_gb                 = 48
  uni2_time                      = '24h'

  hf_home                        = "${baseDir}/.hf_cache"
  hf_hub_cache                   = "${baseDir}/.hf_cache/hub"
  hf_token_env_file              = ''
  hf_token_env_var_name          = 'HF_TOKEN'

  r_script                       = 'bin/run_kodama_analysis.R'
  r_cpus                         = 8
  r_memory_gb                    = 24
  r_time                         = '8h'

  cluster_r_script               = 'bin/Rcode_Clustering.R'
  cluster_kodama_dim             = 20
  cluster_snn_k                  = 100
  cluster_resolution             = 0.2
  cluster_cpus                   = 8
  cluster_memory_gb              = 24
  cluster_time                   = '8h'

  cluster_mask_script            = 'bin/labels_to_cluster_mask.py'
  cluster_mask_default_value     = 0
  cluster_mask_compression       = 'none'
  cluster_mask_preview_factor    = 10
  cluster_mask_cpus              = 8
  cluster_mask_memory_gb         = 16
  cluster_mask_time              = '6h'

  grow_script                    = 'bin/grow_to_tissue.py'
  grow_preview_factor            = 10
  grow_sigma                     = 1.0
  grow_restrict_to_seeded_components = true
  grow_min_seed_area             = 200
  grow_fill_holes_area           = 50000
  grow_close_radius              = 12
  grow_add_nuclei                = true
  grow_nuclei_thresh             = 170
  grow_nuclei_dilate             = 2
  grow_pyr_compression           = 'LZW'
  grow_max_workers               = 16
  grow_downsample                = 'GAUSSIAN'
  grow_legacy                    = false
  grow_overwrite                 = true
  grow_keep_tmp                  = false
  grow_cpus                      = 12
  grow_memory_gb                 = 32
  grow_time                      = '12h'

  cluster_geojson_script         = 'bin/mask_to_geojson.py'
  cluster_geojson_page           = 0
  cluster_geojson_dissolve_by_value = true
  cluster_geojson_min_area       = 500
  cluster_geojson_smooth_buffer  = 10.0
  cluster_geojson_smooth_passes  = 3
  cluster_geojson_simplify       = 6.0
  cluster_geojson_fill_holes     = true
  cluster_geojson_preserve_topology = true
  cluster_geojson_group_map      = ''
  cluster_geojson_group_prefix   = 'color_'
  cluster_geojson_cpus           = 8
  cluster_geojson_memory_gb      = 16
  cluster_geojson_time           = '6h'
}

def requested_arch_raw = (params['host_arch'] ?: 'auto').toString().trim().toLowerCase()
def requested_arch = requested_arch_raw
if (!(requested_arch in ['auto', 'amd64', 'arm64'])) {
  requested_arch = 'auto'
}

def arch_candidates_raw = [
  (System.getProperty('os.arch') ?: ''),
  (System.getenv('NXF_HOST_ARCH') ?: ''),
  (System.getenv('TARGETARCH') ?: '')
]

def uname_arch = ''
try {
  def p = ['bash', '-lc', 'uname -m'].execute()
  def done = p.waitFor(2, java.util.concurrent.TimeUnit.SECONDS)
  if (done && p.exitValue() == 0) {
    uname_arch = (p.in.text ?: '').trim()
  } else {
    p.destroyForcibly()
  }
} catch (Throwable ignored) {}
if (uname_arch) arch_candidates_raw << uname_arch

def dpkg_arch = ''
try {
  def p = ['bash', '-lc', 'dpkg --print-architecture'].execute()
  def done = p.waitFor(2, java.util.concurrent.TimeUnit.SECONDS)
  if (done && p.exitValue() == 0) {
    dpkg_arch = (p.in.text ?: '').trim()
  } else {
    p.destroyForcibly()
  }
} catch (Throwable ignored) {}
if (dpkg_arch) arch_candidates_raw << dpkg_arch

def detected_arch_candidates = []
for (raw_arch in arch_candidates_raw) {
  def value = (raw_arch ?: '').toString().trim().toLowerCase()
  def normalized = 'unknown'
  if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) {
    normalized = 'amd64'
  } else if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) {
    normalized = 'arm64'
  } else if (value == 'auto') {
    normalized = 'auto'
  } else if (value) {
    normalized = value
  }

  if (normalized && normalized != 'unknown' && normalized != 'auto') {
    detected_arch_candidates << normalized
  }
}

def detected_arch = (requested_arch in ['amd64', 'arm64'])
  ? requested_arch
  : (detected_arch_candidates ? detected_arch_candidates[0] : 'unknown')

if (detected_arch == 'unknown') {
  throw new IllegalArgumentException("Could not detect host architecture. Use --host_arch amd64 or --host_arch arm64.")
}

def requested_compute_device = (params['compute_device'] ?: 'auto').toString().trim().toLowerCase()
if (!(requested_compute_device in ['cpu', 'gpu', 'auto'])) {
  requested_compute_device = 'auto'
}

def nvidia_visible = (System.getenv('NVIDIA_VISIBLE_DEVICES') ?: '').toString().trim().toLowerCase()
def cuda_visible = (System.getenv('CUDA_VISIBLE_DEVICES') ?: '').toString().trim().toLowerCase()
def nvidia_hint = nvidia_visible && !(nvidia_visible in ['none', 'void', 'no', 'false', '-1'])
def cuda_hint = cuda_visible && !(cuda_visible in ['none', 'void', 'no', 'false', '-1'])
def detected_nvidia = nvidia_hint || cuda_hint

if (!detected_nvidia) {
  try {
    def p = ['bash', '-lc', 'command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1'].execute()
    def done = p.waitFor(2, java.util.concurrent.TimeUnit.SECONDS)
    if (done && p.exitValue() == 0) {
      detected_nvidia = true
    } else if (!done) {
      p.destroyForcibly()
    }
  } catch (Throwable ignored) {}
}

def resolved_compute_device = requested_compute_device == 'auto'
  ? ((detected_arch == 'amd64' && detected_nvidia) ? 'gpu' : 'cpu')
  : requested_compute_device

if (resolved_compute_device == 'gpu' && detected_arch != 'amd64') {
  throw new IllegalArgumentException("compute_device='gpu' is supported only on amd64/x86_64. Detected architecture '${detected_arch}'.")
}

def container_repo = (params['container_repo'] ?: default_container_repo).toString().trim()
if (!container_repo) container_repo = default_container_repo

def cpu_tag_generic = (params['container_cpu_tag'] ?: default_container_cpu_tag).toString().trim()
if (!cpu_tag_generic) cpu_tag_generic = default_container_cpu_tag

def cpu_tag_arch = ''
if (detected_arch == 'amd64') cpu_tag_arch = default_container_cpu_tag_amd64
if (detected_arch == 'arm64') cpu_tag_arch = default_container_cpu_tag_arm64

def cpu_tag_amd64_override = (params['container_cpu_tag_amd64'] ?: '').toString().trim()
def cpu_tag_arm64_override = (params['container_cpu_tag_arm64'] ?: '').toString().trim()
if (detected_arch == 'amd64' && cpu_tag_amd64_override) cpu_tag_arch = cpu_tag_amd64_override
if (detected_arch == 'arm64' && cpu_tag_arm64_override) cpu_tag_arch = cpu_tag_arm64_override

def selected_cpu_tag = cpu_tag_arch ?: cpu_tag_generic

def selected_gpu_tag = (params['container_gpu_tag'] ?: default_container_gpu_tag).toString().trim()
if (!selected_gpu_tag) selected_gpu_tag = default_container_gpu_tag

def selected_container_tag = resolved_compute_device == 'gpu' ? selected_gpu_tag : selected_cpu_tag
def auto_docker_image = "${container_repo}:${selected_container_tag}"
def auto_singularity_image = "docker://${auto_docker_image}"

def runtime_image_mode = (params['runtime_image_mode'] ?: 'auto').toString().trim().toLowerCase()
if (!(runtime_image_mode in ['auto', 'manual'])) runtime_image_mode = 'auto'

def raw_singularity_image = (params['singularity_image'] ?: '').toString().trim()
def resolved_singularity_image = raw_singularity_image
if (runtime_image_mode == 'auto' || !raw_singularity_image) {
  resolved_singularity_image = auto_singularity_image
} else if (raw_singularity_image.startsWith('docker://')) {
  def ref = raw_singularity_image.replaceFirst('^docker://', '')
  if (!ref.contains('/') || ref.endsWith('.sif')) {
    resolved_singularity_image = auto_singularity_image
  }
} else if (raw_singularity_image.toLowerCase().endsWith('.sif') && !raw_singularity_image.contains('/')) {
  resolved_singularity_image = auto_singularity_image
}

def raw_docker_image = (params['docker_image'] ?: '').toString().trim()
def resolved_docker_image = raw_docker_image
if (runtime_image_mode == 'auto' || !raw_docker_image || raw_docker_image == 'cellphenotyper:full-cpu') {
  resolved_docker_image = auto_docker_image
}

params.compute_device = resolved_compute_device
params._requested_compute_device = requested_compute_device
params._runtime_image_mode = runtime_image_mode
params._detected_arch = detected_arch
params._detected_arch_candidates = detected_arch_candidates.join(',')
params._detected_nvidia = detected_nvidia
params._selected_container_tag = selected_container_tag
params._auto_singularity_image = auto_singularity_image
params._auto_docker_image = auto_docker_image
params.singularity_image = resolved_singularity_image
params.docker_image = resolved_docker_image

process {
  executor = 'local'
  shell = ['/bin/bash', '-euo', 'pipefail']

  withLabel: io_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_medium {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
}

profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.runOptions = params.compute_device == 'gpu' ? '--nv' : ''
    process.container = params.singularity_image
  }

  docker {
    docker.enabled = true
    docker.runOptions = params.compute_device == 'gpu' ? '--gpus all' : ''
    process.container = params.docker_image
  }

  debug {
    params {
      run_full_pipeline = false
      tissue_mask_from_input = true
      write_full_labels = false
      convert_cpus = 2
      tissue_mask_cpus = 2
      tissue_geojson_cpus = 2
    }
    process {
      withLabel: io_heavy {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_medium {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_heavy {
        cpus = 2
        memory = '8 GB'
        time = '2h'
      }
    }
  }
}

manifest {
  name = 'tkcaccia/CellPhenotyper'
  mainScript = 'main.nf'
  defaultBranch = 'main'
}

report {
  enabled = true
  file = "${params.outdir_base}/report_tissue_geojson.html"
  overwrite = true
}

trace {
  enabled = true
  file = "${params.outdir_base}/00_execution/trace.tsv"
  overwrite = true
}

timeline {
  enabled = true
  file = "${params.outdir_base}/00_execution/timeline.html"
  overwrite = true
}

dag {
  enabled = true
  file = "${params.outdir_base}/00_execution/dag.html"
  overwrite = true
}

nextflow.enable.dsl = 2

params {
  image_input                    = null
  roi_geojson                    = null
  outdir_base                    = 'results'

  run_full_pipeline              = true
  tissue_mask_from_input         = false
  compute_device                 = 'cpu'   // cpu | gpu | auto
  uni2_device_auto               = 'cpu'

  singularity_image              = ''
  docker_image                   = ''

  max_cpus                       = Runtime.runtime.availableProcessors()
  max_memory_gb                  = 64

  btf_converter_script           = 'btf_to_ometiff.sh'
  convert_compression            = 'LZW'
  convert_downsample             = 'GAUSSIAN'
  convert_rgb                    = true
  convert_overwrite              = true
  convert_cpus                   = 8
  convert_memory_gb              = 16
  convert_time                   = '6h'

  stardist_script                = 'roi_crop_and_stardist_segment_only_v14.py'
  stardist_model                 = '2D_versatile_he'
  stardist_prob                  = 0.48
  stardist_nms                   = 0.30
  stardist_tiles_x               = 32
  stardist_tiles_y               = 32
  write_full_labels              = true
  full_format                    = 'tif'
  allow_huge_tif                 = true
  stardist_cpus                  = 16
  stardist_memory_gb             = 48
  stardist_time                  = '24h'

  tissue_mask_script             = 'make_tissue_mask.py'
  tissue_work_downsample         = 8
  tissue_preview_factor          = 10
  tissue_close_radius            = 12
  tissue_min_obj_area            = 30000
  tissue_hole_area               = 30000
  tissue_keep_largest            = true
  tissue_tile                    = 512
  tissue_compression             = 'deflate'
  tissue_bigtiff                 = true
  tissue_mask_cpus               = 8
  tissue_mask_memory_gb          = 16
  tissue_mask_time               = '6h'

  tissue_geojson_script          = 'mask_to_geojson.py'
  tissue_geojson_page            = 0
  tissue_geojson_binary          = true
  tissue_geojson_dissolve        = true
  tissue_geojson_dissolve_by_value = false
  tissue_geojson_min_area        = 2500
  tissue_geojson_smooth_buffer   = 6
  tissue_geojson_smooth_passes   = 2
  tissue_geojson_simplify        = 2
  tissue_geojson_preserve_topology = true
  tissue_geojson_fill_holes      = true
  tissue_geojson_cpus            = 8
  tissue_geojson_memory_gb       = 16
  tissue_geojson_time            = '6h'

  assign_script                  = 'assign_cells_to_geojson_polygons_v6.py'
  assign_label_prop              = 'name'
  assign_out_col                 = 'polygon_label'
  assign_choose                  = 'smallest'
  assign_chunk_rows              = 20000
  assign_xcol                    = null
  assign_ycol                    = null
  assign_cpus                    = 12
  assign_memory_gb               = 24
  assign_time                    = '6h'

  expand_script                  = 'expand_cells_to_cytoplasm.py'
  expand_px                      = 12
  expand_compression             = 'zlib'
  expand_cpus                    = 8
  expand_memory_gb               = 16
  expand_time                    = '4h'

  uni2_script                    = 'uni2_embeddings.py'
  uni2_image_level               = 0
  uni2_force_full_image          = true
  uni2_grid                      = '10x10'
  uni2_tile_size                 = 224
  uni2_save_tiles                = true
  uni2_tiles_root                = 'tiles'
  uni2_bucket_size               = 5000
  uni2_min_area                  = 0
  uni2_encoder                   = 'uni2-h'
  uni2_backend                   = 'auto'
  uni2_pooling                   = 'auto'
  uni2_img_size                  = 224
  uni2_batch                     = 64
  uni2_torch_threads             = 16
  uni2_rows_per_csv              = 10000
  uni2_mask_block                = 4096
  uni2_cpus                      = 16
  uni2_memory_gb                 = 48
  uni2_time                      = '24h'

  hf_home                        = "${baseDir}/.hf_cache"
  hf_hub_cache                   = "${baseDir}/.hf_cache/hub"
  hf_token_env_var_name          = 'HF_TOKEN'

  r_script                       = 'Rcode.R'
  r_cpus                         = 8
  r_memory_gb                    = 24
  r_time                         = '8h'
}

process {
  executor = 'local'
  shell = ['/bin/bash', '-euo', 'pipefail']

  withLabel: io_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_medium {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
}

profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.runOptions = params.compute_device == 'gpu' ? '--nv' : ''
    process.container = params.singularity_image
  }

  docker {
    docker.enabled = true
    docker.runOptions = params.compute_device == 'gpu' ? '--gpus all' : ''
    process.container = params.docker_image
  }

  debug {
    params {
      run_full_pipeline = false
      tissue_mask_from_input = true
      write_full_labels = false
      convert_cpus = 2
      tissue_mask_cpus = 2
      tissue_geojson_cpus = 2
    }
    process {
      withLabel: io_heavy {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_medium {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_heavy {
        cpus = 2
        memory = '8 GB'
        time = '2h'
      }
    }
  }
}

manifest {
  name = 'tkcaccia/CellPhenotyper'
  mainScript = 'main.nf'
  defaultBranch = 'main'
}

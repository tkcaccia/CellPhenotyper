// Profile run options are resolved while the config is parsed, before main.nf
// stores `_resolved_compute_device`. Keep this decision equivalent to main.nf.
def configured_compute_request = (params.compute_device ?: 'auto').toString().trim().toLowerCase()
if (!(configured_compute_request in ['cpu', 'gpu', 'auto'])) configured_compute_request = 'auto'
def configured_host_arch = (params.host_arch ?: 'auto').toString().trim().toLowerCase()
if (configured_host_arch in ['x86_64', 'x64', 'x86-64']) configured_host_arch = 'amd64'
if (configured_host_arch in ['aarch64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) configured_host_arch = 'arm64'
if (configured_host_arch == 'auto') {
  configured_host_arch = System.getProperty('os.arch').toString().trim().toLowerCase()
  if (configured_host_arch in ['x86_64', 'x64', 'x86-64']) configured_host_arch = 'amd64'
  if (configured_host_arch in ['aarch64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) configured_host_arch = 'arm64'
}
def configured_enable_gpu_arm64 = (params.enable_gpu_on_arm64 ?: false).toString().trim().toLowerCase() in ['true', '1', 'yes', 'y', 'on']
def configured_gpu_allowed = configured_host_arch == 'amd64' || (configured_host_arch == 'arm64' && configured_enable_gpu_arm64)
def configured_nvidia_visible = false
def configured_nvidia_visible_env = (System.getenv('NVIDIA_VISIBLE_DEVICES') ?: '').toString().trim().toLowerCase()
def configured_cuda_visible_env = (System.getenv('CUDA_VISIBLE_DEVICES') ?: '').toString().trim().toLowerCase()
configured_nvidia_visible = (
  configured_nvidia_visible_env && !(configured_nvidia_visible_env in ['none', 'void', 'no', 'false', '-1'])
) || (
  configured_cuda_visible_env && !(configured_cuda_visible_env in ['none', 'void', 'no', 'false', '-1'])
)
if (!configured_nvidia_visible && configured_compute_request == 'auto') {
  try {
    def proc = ['bash', '-lc', 'command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1'].execute()
    def finished = proc.waitFor(3, java.util.concurrent.TimeUnit.SECONDS)
    if (!finished) proc.destroyForcibly()
    configured_nvidia_visible = finished && proc.exitValue() == 0
  } catch (Throwable ignored) {
    configured_nvidia_visible = false
  }
}
def configured_gpu_runtime = configured_gpu_allowed && (
  configured_compute_request == 'gpu' || (configured_compute_request == 'auto' && configured_nvidia_visible)
)

// Migrated modules receive a concrete task input. Legacy modules retain the
// config-resolved device; never rely on params mutated after a module include.
def validate_leased_gpu_ordinal = { Map p, String processName, String requested ->
  if (as_boolean.call(container_param_or.call(p, 'gpu_scheduler_enable', true), true) && requested != '0')
    throw new IllegalArgumentException("${processName} requests GPU ordinal ${requested}, but dynamic GPU admission exposes one leased device as ordinal 0; use ordinal 0 or disable gpu_scheduler_enable for an explicitly managed allocation")
}
def effective_task_device = { Map p, String processName, def explicitPlan ->
  // ConfigSlurper supplies an empty ConfigObject for an absent task variable.
  // A real (even empty/malformed) input Map must still be validated below.
  if (explicitPlan instanceof groovy.util.ConfigObject && explicitPlan.isEmpty()) explicitPlan = null
  if (processName.endsWith('PREPARE_HIERARCHY_FEATURES')) {
    def requested = (p.tissue_hierarchy_device ?: 'cuda').toString().trim().toLowerCase()
    if (!(requested in ['cpu', 'cuda', 'mps'])) throw new IllegalArgumentException('tissue_hierarchy_device must be cpu, cuda, or mps')
    return requested == 'cuda' ? 'gpu' : requested
  }
  if (processName.endsWith('RUN_KODAMA_ANALYSIS') || processName.endsWith('RUN_KODAMA_CELL_AUXILIARY') || processName.endsWith('RUN_GIGATIME_KODAMA')) {
    def backend = (p.kodama_backend ?: 'cpu').toString().trim().toLowerCase()
    if (!(backend in ['cpu', 'cuda', 'metal'])) throw new IllegalArgumentException('kodama_backend must be cpu, cuda, or metal')
    if (backend == 'cuda') validate_leased_gpu_ordinal.call(p, processName, container_param_or.call(p, 'kodama_gpu_device', 0).toString())
    return backend == 'cuda' ? 'gpu' : backend
  }
  if (processName.endsWith('REFINE_GROWN_TISSUE_MEDSAM') || processName.endsWith('REFINE_CELL_AUXILIARY_MEDSAM')) {
    def requested = (p.medsam_device ?: 'auto').toString().trim().toLowerCase()
    if (requested ==~ /cuda(:\d+)?/) {
      validate_leased_gpu_ordinal.call(p, processName, requested.contains(':') ? requested.split(':')[1] : '0')
      return 'gpu'
    }
    if (requested in ['cpu', 'mps']) return requested
    if (requested != 'auto') throw new IllegalArgumentException('medsam_device must be auto, cpu, cuda, cuda:N, or mps')
  }
  if (processName.endsWith('RUN_GRANDQC_ARTIFACT_ANALYSIS')) {
    def requested = (p.grandqc_device ?: 'auto').toString().trim().toLowerCase()
    if (requested in ['cpu', 'mps']) return requested
    if (requested == 'cuda') return 'gpu'
    if (requested != 'auto') throw new IllegalArgumentException('grandqc_device must be auto, cpu, cuda, or mps')
  }
  def ordinalKey = processName.endsWith('RUN_CELLVITPP') ? 'cellvit_gpu' :
    (processName.endsWith('RUN_HOVERNET_MONUSAC') ? 'hovernet_gpu' :
    (processName.endsWith('EXTRACT_TITAN_SECTION_EMBEDDING') ? 'titan_gpu' : null))
  if (ordinalKey) validate_leased_gpu_ordinal.call(p, processName, container_param_or.call(p, ordinalKey, 0).toString())
  if (processName.endsWith('RUN_STARDIST_ROI_SEGMENTATION') && configured_host_arch == 'arm64' &&
      !as_boolean.call(container_param_or.call(p, 'enable_stardist_gpu_on_arm64', false), false)) return 'cpu'
  if (explicitPlan != null) {
    if (!(explicitPlan instanceof Map) || !(explicitPlan.compute_device in ['cpu', 'gpu']))
      throw new IllegalArgumentException("Invalid concrete runtime_plan device for ${processName} (${explicitPlan.getClass().name})")
    return explicitPlan.compute_device.toString()
  }
  def resolved = container_param_or.call(p, '_resolved_compute_device', container_param_or.call(p, 'compute_device', 'auto')).toString().trim().toLowerCase()
  if (!(resolved in ['cpu', 'gpu'])) resolved = configured_gpu_runtime ? 'gpu' : 'cpu'
  return resolved
}

def gpu_task_container_options = { Map p, String processName, def explicitPlan, String engine ->
  def options = []
  def device = effective_task_device.call(p, processName, explicitPlan)
  if (device in ['mps', 'metal']) throw new IllegalArgumentException("${device} execution for ${processName} is native-only and cannot run in a Linux ${engine} container")
  if (device == 'gpu') {
    if (engine == 'singularity') {
      // envWhitelist uses ${VAR:+...}, which drops explicitly empty values.
      // Preserve the unset-versus-empty CUDA mask without inventing a device.
      options << '--nv ${CUDA_VISIBLE_DEVICES+--env CUDA_VISIBLE_DEVICES="$CUDA_VISIBLE_DEVICES"}'
    } else {
      options << '--gpus all --shm-size=3g --env CUDA_VISIBLE_DEVICES --env CELLPHENOTYPER_GPU_INDEX'
    }
  }
  // A label directive replaces module containerOptions; retain the two existing
  // stage-specific additions when composing the profile's GPU exposure flags.
  if (processName.endsWith('EXTRACT_TITAN_SECTION_EMBEDDING')) {
    def modelPath = (p.titan_model ?: '').toString().trim()
    if (modelPath && new File(modelPath).isAbsolute()) {
      def quotedPath = "'${modelPath.replace("'", "'\"'\"'")}:${modelPath.replace("'", "'\"'\"'")}:ro'"
      options << "${engine == 'singularity' ? '-B' : '-v'} ${quotedPath}"
    }
  }
  if (processName.endsWith('RUN_HOVERNET_MONUSAC')) {
    def extras = (System.getenv('CELLPHENOTYPER_HOVERNET_CONTAINER_OPTIONS') ?: '').trim()
    if (extras) options << extras
  }
  return options.join(' ')
}

// Assign this same closure inside each container profile: Nextflow replaces a
// repeated withLabel selector map instead of merging its individual directives.
def gpu_admission_before_script = {
      def explicitPlan = null
      try { explicitPlan = runtime_plan } catch (MissingPropertyException ignored) {}
      def processName = task.process.toString()
      def device = effective_task_device.call(params, processName, explicitPlan)
      if (device != 'gpu') return "export CUDA_VISIBLE_DEVICES=''\n"
      def enabled = as_boolean.call(params.gpu_scheduler_enable, true)
      if (!enabled) return ''
      def requiredGb = params.gpu_default_task_memory_gb as double
      if (processName.endsWith('PREPARE_HIERARCHY_FEATURES')) {
        // Physical-field UNI2 inference has its own explicit device selection.
        // CPU/MPS must not acquire a CUDA device merely because one is visible.
        if ((params.tissue_hierarchy_device ?: 'cuda').toString().trim().toLowerCase() != 'cuda') return ''
        requiredGb = params.uni2_gpu_memory_gb as double
      }
      else if (processName.endsWith('RUN_GRANDQC_ARTIFACT_ANALYSIS')) requiredGb = params.grandqc_gpu_memory_gb as double
      else if (processName.endsWith('RUN_STARDIST_ROI_SEGMENTATION')) requiredGb = params.stardist_gpu_memory_gb as double
      else if (processName.endsWith('RUN_HOVERNET_MONUSAC')) requiredGb = params.hovernet_gpu_memory_gb as double
      else if (processName.endsWith('RUN_CELLVITPP')) requiredGb = params.cellvit_gpu_memory_gb as double
      else if (processName.endsWith('RUN_GIGATIME_ON_CROP')) requiredGb = params.gigatime_gpu_memory_gb as double
      else if (processName.contains('EXTRACT_UNI2_EMBEDDINGS') || processName.endsWith('EXTRACT_UNI2_CELL_AUXILIARY')) requiredGb = params.uni2_gpu_memory_gb as double
      else if (processName.endsWith('REFINE_GROWN_TISSUE_MEDSAM') || processName.endsWith('REFINE_CELL_AUXILIARY_MEDSAM')) requiredGb = params.medsam_gpu_memory_gb as double
      else if (processName.endsWith('RUN_PATHSEGMENTOR_SEMANTICS')) requiredGb = params.pathsegmentor_gpu_memory_gb as double
      else if (processName.endsWith('RUN_KODAMA_ANALYSIS') || processName.endsWith('RUN_KODAMA_CELL_AUXILIARY') || processName.endsWith('RUN_GIGATIME_KODAMA')) {
        requiredGb = params.kodama_gpu_memory_gb as double
      }
      else if (processName.endsWith('EXTRACT_TITAN_SECTION_EMBEDDING')) requiredGb = params.titan_gpu_memory_gb as double
      return """
      source '${baseDir}/bin/acquire_gpu_slot.sh'
      cellphenotyper_acquire_gpu_slot '${params.gpu_lock_dir}' '${requiredGb}' '${params.gpu_memory_reserve_gb}' '${params.gpu_memory_token_gb}' '${params.gpu_max_tasks_per_device}' '${params.gpu_scheduler_poll_seconds}' '${params.gpu_scheduler_timeout_seconds}'
      export SINGULARITYENV_CUDA_VISIBLE_DEVICES="\$CUDA_VISIBLE_DEVICES"
      export APPTAINERENV_CUDA_VISIBLE_DEVICES="\$CUDA_VISIBLE_DEVICES"
      export SINGULARITYENV_CELLPHENOTYPER_GPU_INDEX="\$CELLPHENOTYPER_GPU_INDEX"
      export APPTAINERENV_CELLPHENOTYPER_GPU_INDEX="\$CELLPHENOTYPER_GPU_INDEX"
      """
}

process {
  executor = 'local'
  shell = ['/bin/bash', '-euo', 'pipefail']

  withLabel: gpu_capable {
    beforeScript = gpu_admission_before_script
  }

  withLabel: io_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_medium {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
}

def singularity_bind_targets = [
  params.image_input,
  params.folder_input,
  params.roi_geojson,
  params.study_manifest,
  params.outdir_base,
  params.hf_home,
  params.hf_hub_cache,
  params.hf_token_env_file,
  params.stardist_keras_home,
  params.stardist_pretrained_zip,
  params.grandqc_cache_dir,
  params.titan_cache_dir,
  params.pathofmpred_library_dir,
  params.pathsegmentor_repo,
  params.pathsegmentor_config,
  params.pathsegmentor_checkpoint,
  params.singularity_local_dir
].collectMany { raw ->
  if (raw == null) {
    return []
  }
  def value = raw.toString().trim()
  if (!value) {
    return []
  }
  def file = new File(value)
  def target = file.isDirectory() ? file : file.getParentFile()
  if (target == null) {
    return []
  }
  def targets = [target.exists() ? target.getCanonicalPath() : target.getAbsolutePath()]
  if (file.isDirectory()) {
    file.eachFile { child ->
      try {
        if (java.nio.file.Files.isSymbolicLink(child.toPath())) {
          def resolved = child.getCanonicalFile()
          def resolvedTarget = resolved.isDirectory() ? resolved : resolved.getParentFile()
          if (resolvedTarget != null) {
            targets << resolvedTarget.getCanonicalPath()
          }
        }
      } catch (ignored) {
        // Best-effort bind expansion; invalid symlinks are handled by the pipeline input checks.
      }
    }
  }
  targets
}.findAll { it }.unique().sort()

profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    // Nextflow launches Singularity through `env -`; forward the GPU selected
    // by the host-side lease dynamically, using SINGULARITYENV_* assignments.
    singularity.envWhitelist = 'CUDA_VISIBLE_DEVICES,CELLPHENOTYPER_GPU_INDEX'
    singularity.cacheDir = (params.singularity_cache_dir ?: "${baseDir}/.apptainer_cache").toString()
    def singularityBindRunOptions = singularity_bind_targets.collect { "-B ${it}" }.join(' ')
    singularity.runOptions = singularityBindRunOptions
    process.container = {
      def paramOr = { String key, def fallback ->
        def value = params.containsKey(key) ? params[key] : null
        if (value == null) return fallback
        if (value instanceof CharSequence && value.toString().trim().isEmpty()) return fallback
        value
      }
      def normalizeArch = { raw ->
        def value = (raw ?: '').toString().trim().toLowerCase()
        if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
        if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
        if (value == 'auto') return 'auto'
        value
      }
      def normalizeSource = { raw ->
        def value = (raw ?: 'auto').toString().trim().toLowerCase()
        (value in ['auto', 'oras', 'release', 'docker']) ? value : 'auto'
      }
      def runtimeMode = (paramOr('runtime_image_mode', 'auto') ?: 'auto').toString().trim().toLowerCase()
      if (!(runtimeMode in ['auto', 'manual'])) runtimeMode = 'auto'

      def legacyManual = (paramOr('singularity_image', '') ?: '').toString().trim()
      def cpuManual = (paramOr('cpu_container_image', '') ?: '').toString().trim()
      if (cpuManual) return cpuManual
      if (runtimeMode == 'manual' && legacyManual) return legacyManual

      def hostArch = normalizeArch(paramOr('host_arch', 'auto'))
      if (!hostArch || hostArch == 'auto') hostArch = normalizeArch(System.getProperty('os.arch'))
      if (!(hostArch in ['amd64', 'arm64'])) hostArch = 'amd64'

      def repo = (paramOr('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
      if (!repo) repo = default_container_repo
      def cpuTagAmd64 = (paramOr('container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
      if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
      def cpuTagArm64 = (paramOr('container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
      if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
      def cpuTag = hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64
      def cpuDockerRef = "docker://${repo}:${cpuTag}"

      def sourceMode = normalizeSource(paramOr('singularity_image_source', 'auto'))
      if (sourceMode == 'docker') return cpuDockerRef

      def orasRepo = (paramOr('singularity_oras_repo', repo) ?: repo).toString().trim()
      def cpuOrasTagAmd64 = (paramOr('singularity_cpu_oras_tag_amd64', '2.2-sif-amd64') ?: '2.2-sif-amd64').toString().trim()
      def cpuOrasTagArm64 = (paramOr('singularity_cpu_oras_tag_arm64', '2.2-sif-arm64') ?: '2.2-sif-arm64').toString().trim()
      def releaseRepo = (paramOr('singularity_release_repo', 'tkcaccia/CellPhenotyper') ?: 'tkcaccia/CellPhenotyper').toString().trim()
      def releaseTag = (paramOr('singularity_release_tag', 'v2.2') ?: 'v2.2').toString().trim()
      def cpuAssetAmd64 = (paramOr('singularity_cpu_asset_amd64', 'cellphenotyper-2.2-amd64.sif') ?: 'cellphenotyper-2.2-amd64.sif').toString().trim()
      def cpuAssetArm64 = (paramOr('singularity_cpu_asset_arm64', 'cellphenotyper-2.2-arm64.sif') ?: 'cellphenotyper-2.2-arm64.sif').toString().trim()
      def cpuAsset = hostArch == 'amd64' ? cpuAssetAmd64 : cpuAssetArm64
      def cpuOrasTag = hostArch == 'amd64' ? cpuOrasTagAmd64 : cpuOrasTagArm64
      def localDir = (paramOr('singularity_local_dir', '') ?: '').toString().trim()

      def localCandidates = []
      if (localDir) localCandidates << new File(localDir, cpuAsset)
      localCandidates << new File(baseDir.toString(), cpuAsset)
      localCandidates << new File(baseDir.toString(), "singularity/${cpuAsset}")
      for (f in localCandidates) {
        try {
          if (f.exists() && f.isFile()) return f.absolutePath
        } catch (Throwable ignored) {}
      }

      def orasRef = singularity_oras_ref.call(orasRepo, cpuOrasTag)
      if (orasRef && sourceMode in ['auto', 'oras']) return orasRef
      if (sourceMode == 'oras') {
        println "WARN: ORAS-hosted Singularity image metadata is incomplete for tag '${cpuOrasTag ?: 'unknown'}'; falling back to ${cpuDockerRef}"
      }

      if (releaseRepo && releaseTag && cpuAsset) {
        def releaseUrl = "https://github.com/${releaseRepo}/releases/download/${releaseTag}/${cpuAsset}"
        try {
          def escaped = releaseUrl.replace("'", "'\"'\"'")
          def proc = ['bash', '-lc', "curl -fsIL --max-time 12 '${escaped}' >/dev/null 2>&1"].execute()
          def finished = proc.waitFor(3, java.util.concurrent.TimeUnit.SECONDS)
          if (finished && proc.exitValue() == 0) return releaseUrl
        } catch (Throwable ignored) {}
        if (sourceMode == 'release') {
          println "WARN: Release-hosted Singularity image is not reachable (${releaseUrl}); falling back to ${cpuDockerRef}"
        }
      }

      cpuDockerRef
    }
    process {
      withLabel: gpu_capable {
        beforeScript = gpu_admission_before_script
        containerOptions = {
          def explicitPlan = null
          try { explicitPlan = runtime_plan } catch (MissingPropertyException ignored) {}
          gpu_task_container_options.call(params, task.process.toString(), explicitPlan, 'singularity')
        }
        container = {
          def paramOr = { String key, def fallback ->
            def value = params.containsKey(key) ? params[key] : null
            if (value == null) return fallback
            if (value instanceof CharSequence && value.toString().trim().isEmpty()) return fallback
            value
          }
          def normalizeArch = { raw ->
            def value = (raw ?: '').toString().trim().toLowerCase()
            if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
            if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
            if (value == 'auto') return 'auto'
            value
          }
          def normalizeSource = { raw ->
            def value = (raw ?: 'auto').toString().trim().toLowerCase()
            (value in ['auto', 'oras', 'release', 'docker']) ? value : 'auto'
          }
          def parseBool = { raw ->
            def value = (raw ?: false).toString().trim().toLowerCase()
            value in ['true', '1', 'yes', 'y', 'on']
          }
          def runtimeMode = (paramOr('runtime_image_mode', 'auto') ?: 'auto').toString().trim().toLowerCase()
          if (!(runtimeMode in ['auto', 'manual'])) runtimeMode = 'auto'

          def legacyManual = (paramOr('singularity_image', '') ?: '').toString().trim()
          def cpuManual = (paramOr('cpu_container_image', '') ?: '').toString().trim()
          def gpuManual = (paramOr('gpu_container_image', '') ?: '').toString().trim()
          if (runtimeMode == 'manual' && legacyManual) return legacyManual

          def hostArch = normalizeArch(paramOr('host_arch', 'auto'))
          if (!hostArch || hostArch == 'auto') hostArch = normalizeArch(System.getProperty('os.arch'))
          if (!(hostArch in ['amd64', 'arm64'])) hostArch = 'amd64'

          def repo = (paramOr('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
          if (!repo) repo = default_container_repo
          def gpuRepo = (paramOr('container_gpu_repo', default_container_gpu_repo) ?: default_container_gpu_repo).toString().trim()
          if (!gpuRepo) gpuRepo = default_container_gpu_repo
          def cpuTagAmd64 = (paramOr('container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
          if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
          def cpuTagArm64 = (paramOr('container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
          if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
          def cpuFallback = cpuManual ?: (runtimeMode == 'manual' && legacyManual ? legacyManual : "docker://${repo}:${hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64}")

          def explicitPlan = null
          try { explicitPlan = runtime_plan } catch (MissingPropertyException ignored) {}
          def computeDevice = effective_task_device.call(params, task.process.toString(), explicitPlan)
          def enableGpuArm64 = parseBool(paramOr('enable_gpu_on_arm64', false))
          def enableStardistGpuArm64 = parseBool(paramOr('enable_stardist_gpu_on_arm64', false))
          def gpuAllowed = hostArch == 'amd64' || (hostArch == 'arm64' && enableGpuArm64)
          if (hostArch == 'arm64' && task.process.toString().endsWith('RUN_STARDIST_ROI_SEGMENTATION') && !enableStardistGpuArm64) {
            println "WARN: RUN_STARDIST_ROI_SEGMENTATION uses CPU container on arm64 by default (set --enable_stardist_gpu_on_arm64 true to override)."
            return cpuFallback
          }
          if (computeDevice != 'gpu') return cpuFallback
          if (!gpuAllowed) throw new IllegalArgumentException("GPU task ${task.process} is incompatible with host_arch=${hostArch}; enable_gpu_on_arm64 and a compatible GPU image are required")
          if (gpuManual) return gpuManual

          def gpuTag = (paramOr('container_gpu_tag', default_container_gpu_tag) ?: default_container_gpu_tag).toString().trim()
          if (!gpuTag) gpuTag = default_container_gpu_tag
          def gpuDockerRef = "docker://${gpuRepo}:${gpuTag}"

          def sourceMode = normalizeSource(paramOr('singularity_gpu_image_source', 'docker'))
          if (sourceMode == 'docker' && hostArch == 'arm64') {
            throw new IllegalArgumentException("No default arm64 GPU OCI image is configured for ${task.process}; provide --gpu_container_image with a compatible arm64 GPU image")
          }
          if (sourceMode == 'docker') return gpuDockerRef

          def orasRepo = (paramOr('singularity_oras_repo', repo) ?: repo).toString().trim()
          def gpuOrasTagAmd64 = (paramOr('singularity_gpu_oras_tag_amd64', '2.2-sif-gpu-amd64') ?: '2.2-sif-gpu-amd64').toString().trim()
          def gpuOrasTagArm64 = (paramOr('singularity_gpu_oras_tag_arm64', '2.2-sif-gpu-arm64') ?: '2.2-sif-gpu-arm64').toString().trim()
          def releaseRepo = (paramOr('singularity_release_repo', 'tkcaccia/CellPhenotyper') ?: 'tkcaccia/CellPhenotyper').toString().trim()
          def releaseTag = (paramOr('singularity_release_tag', 'v2.2') ?: 'v2.2').toString().trim()
          def gpuAssetAmd64 = (paramOr('singularity_gpu_asset_amd64', 'cellphenotyper-2.2-gpu-amd64.sif') ?: 'cellphenotyper-2.2-gpu-amd64.sif').toString().trim()
          def gpuAssetArm64 = (paramOr('singularity_gpu_asset_arm64', 'cellphenotyper-2.2-gpu-arm64.sif') ?: 'cellphenotyper-2.2-gpu-arm64.sif').toString().trim()
          def gpuAsset = hostArch == 'amd64' ? gpuAssetAmd64 : gpuAssetArm64
          def gpuOrasTag = hostArch == 'amd64' ? gpuOrasTagAmd64 : gpuOrasTagArm64
          def localDir = (paramOr('singularity_local_dir', '') ?: '').toString().trim()

          def localCandidates = []
          if (localDir) localCandidates << new File(localDir, gpuAsset)
          localCandidates << new File(baseDir.toString(), gpuAsset)
          localCandidates << new File(baseDir.toString(), "singularity/${gpuAsset}")
          for (f in localCandidates) {
            try {
              if (f.exists() && f.isFile()) return f.absolutePath
            } catch (Throwable ignored) {}
          }

          def orasRef = singularity_oras_ref.call(orasRepo, gpuOrasTag)
          if (orasRef && sourceMode in ['auto', 'oras']) return orasRef
          if (sourceMode == 'oras' && hostArch == 'arm64') {
            println "WARN: arm64 GPU ORAS Singularity tag is not configured; using CPU container for ${task.process}."
          } else if (sourceMode == 'oras') {
            println "WARN: ORAS-hosted GPU Singularity image metadata is incomplete for tag '${gpuOrasTag ?: 'unknown'}'; falling back to ${gpuDockerRef}"
          }

          if (releaseRepo && releaseTag && gpuAsset) {
            def releaseUrl = "https://github.com/${releaseRepo}/releases/download/${releaseTag}/${gpuAsset}"
            try {
              def escaped = releaseUrl.replace("'", "'\"'\"'")
              def proc = ['bash', '-lc', "curl -fsIL --max-time 12 '${escaped}' >/dev/null 2>&1"].execute()
              def finished = proc.waitFor(3, java.util.concurrent.TimeUnit.SECONDS)
              if (finished && proc.exitValue() == 0) return releaseUrl
            } catch (Throwable ignored) {}
            if (sourceMode == 'release' || hostArch == 'arm64') {
              println "WARN: arm64 GPU Singularity asset is not reachable (${releaseUrl}); using CPU container for ${task.process}."
            }
          }

          if (hostArch == 'arm64') {
            throw new IllegalArgumentException("No compatible arm64 GPU Singularity image found for ${task.process}; provide --gpu_container_image")
          }
          gpuDockerRef
        }
      }
    }
  }

  docker {
    docker.enabled = true
    def dockerExtraOptions = ((params.containsKey('docker_extra_run_options') ? params.docker_extra_run_options : '') ?: '').toString().trim()
    docker.runOptions = dockerExtraOptions
    process.container = {
      def paramOr = { String key, def fallback ->
        def value = params.containsKey(key) ? params[key] : null
        if (value == null) return fallback
        if (value instanceof CharSequence && value.toString().trim().isEmpty()) return fallback
        value
      }
      def normalizeArch = { raw ->
        def value = (raw ?: '').toString().trim().toLowerCase()
        if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
        if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
        value
      }
      def hostArch = normalizeArch(paramOr('host_arch', 'auto'))
      if (!hostArch || hostArch == 'auto') hostArch = normalizeArch(System.getProperty('os.arch'))
      if (!(hostArch in ['amd64', 'arm64'])) hostArch = 'amd64'

      def manualCpu = (paramOr('cpu_container_image', '') ?: '').toString().replaceFirst('^docker://', '').trim()
      if (manualCpu) return manualCpu
      def runtimeMode = (paramOr('runtime_image_mode', 'auto') ?: 'auto').toString().toLowerCase()
      if (runtimeMode == 'manual') {
        def legacy = (paramOr('docker_image', '') ?: '').toString().replaceFirst('^docker://', '').trim()
        if (legacy && legacy != 'cellphenotyper:full-cpu') return legacy
      }
      def repo = (paramOr('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
      if (!repo) repo = default_container_repo
      def cpuTagAmd64 = (paramOr('container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
      if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
      def cpuTagArm64 = (paramOr('container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
      if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
      def cpuTag = hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64
      "${repo}:${cpuTag}"
    }
    process {
      withLabel: gpu_capable {
        beforeScript = gpu_admission_before_script
        containerOptions = {
          def explicitPlan = null
          try { explicitPlan = runtime_plan } catch (MissingPropertyException ignored) {}
          gpu_task_container_options.call(params, task.process.toString(), explicitPlan, 'docker')
        }
        container = {
          def paramOr = { String key, def fallback ->
            def value = params.containsKey(key) ? params[key] : null
            if (value == null) return fallback
            if (value instanceof CharSequence && value.toString().trim().isEmpty()) return fallback
            value
          }
          def normalizeArch = { raw ->
            def value = (raw ?: '').toString().trim().toLowerCase()
            if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
            if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
            if (value == 'auto') return 'auto'
            value
          }
          def parseBool = { raw ->
            def value = (raw ?: false).toString().trim().toLowerCase()
            value in ['true', '1', 'yes', 'y', 'on']
          }
          def manualGpu = (paramOr('gpu_container_image', '') ?: '').toString().replaceFirst('^docker://', '').trim()
          def manualCpu = (paramOr('cpu_container_image', '') ?: '').toString().replaceFirst('^docker://', '').trim()
          def runtimeMode = (paramOr('runtime_image_mode', 'auto') ?: 'auto').toString().trim().toLowerCase()
          def legacyManual = (paramOr('docker_image', '') ?: '').toString().replaceFirst('^docker://', '').trim()
          if (runtimeMode == 'manual' && legacyManual && legacyManual != 'cellphenotyper:full-cpu') return legacyManual
          def hostArch = normalizeArch(paramOr('host_arch', 'auto'))
          if (!hostArch || hostArch == 'auto') hostArch = normalizeArch(System.getProperty('os.arch'))
          if (!(hostArch in ['amd64', 'arm64'])) hostArch = 'amd64'
          def repo = (paramOr('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
          if (!repo) repo = default_container_repo
          def gpuRepo = (paramOr('container_gpu_repo', default_container_gpu_repo) ?: default_container_gpu_repo).toString().trim()
          if (!gpuRepo) gpuRepo = default_container_gpu_repo
          def cpuTagAmd64 = (paramOr('container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
          if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
          def cpuTagArm64 = (paramOr('container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
          if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
          def cpuFallback = manualCpu ?: "${repo}:${hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64}"
          def explicitPlan = null
          try { explicitPlan = runtime_plan } catch (MissingPropertyException ignored) {}
          def computeDevice = effective_task_device.call(params, task.process.toString(), explicitPlan)
          if (computeDevice != 'gpu') return cpuFallback
          def enableStardistGpuArm64 = parseBool(paramOr('enable_stardist_gpu_on_arm64', false))
          if (hostArch == 'arm64' && task.process.toString().endsWith('RUN_STARDIST_ROI_SEGMENTATION') && !enableStardistGpuArm64) {
            println "WARN: RUN_STARDIST_ROI_SEGMENTATION uses CPU container on arm64 by default (set --enable_stardist_gpu_on_arm64 true to override)."
            return cpuFallback
          }
          def enableGpuArm64 = parseBool(paramOr('enable_gpu_on_arm64', false))
          if (hostArch == 'arm64' && !enableGpuArm64)
            throw new IllegalArgumentException("GPU task ${task.process} is incompatible with host_arch=arm64; enable_gpu_on_arm64 and a compatible GPU image are required")
          if (manualGpu) return manualGpu
          if (hostArch == 'arm64') {
            throw new IllegalArgumentException("No default arm64 GPU Docker image is configured for ${task.process}; provide --gpu_container_image with a compatible arm64 GPU image")
          }
          def gpuTag = (paramOr('container_gpu_tag', default_container_gpu_tag) ?: default_container_gpu_tag).toString().trim()
          if (!gpuTag) gpuTag = default_container_gpu_tag
          "${gpuRepo}:${gpuTag}"
        }
      }
    }
  }

  debug {
    params {
      run_full_pipeline = false
      write_full_labels = false
      convert_cpus = 2
    }
    process {
      withLabel: io_heavy {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_medium {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_heavy {
        cpus = 2
        memory = '8 GB'
        time = '2h'
      }
    }
  }
}

manifest {
  name = 'tkcaccia/CellPhenotyper'
  mainScript = 'main.nf'
  defaultBranch = 'main'
}

report {
  enabled = true
  file = "${params.outdir_base}/report_pipeline.html"
  overwrite = true
}

trace {
  enabled = true
  file = "${params.outdir_base}/00_execution/trace.tsv"
  overwrite = true
}

timeline {
  enabled = true
  file = "${params.outdir_base}/00_execution/timeline.html"
  overwrite = true
}

dag {
  enabled = true
  file = "${params.outdir_base}/00_execution/dag.html"
  overwrite = true
}

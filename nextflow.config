nextflow.enable.dsl = 2

executor {
  cpus = ((params.max_cpus ?: 4) as int)
}

def default_container_repo = 'ghcr.io/tkcaccia/cellphenotyper'
def default_container_cpu_tag = '2.2'
def default_container_cpu_tag_amd64 = '2.2-amd64'
def default_container_cpu_tag_arm64 = '2.2-arm64'
def default_container_gpu_tag = '2.2-gpu'

def container_param_or = { Map p, String key, def fallback ->
  def value = p.containsKey(key) ? p[key] : null
  if (value == null) return fallback
  if (value instanceof CharSequence && value.toString().trim().isEmpty()) return fallback
  value
}

def normalize_arch = { raw ->
  def value = (raw ?: '').toString().trim().toLowerCase()
  if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
  if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
  if (value == 'auto') return 'auto'
  value
}

def normalize_compute_device = { raw ->
  def value = (raw ?: 'cpu').toString().trim().toLowerCase()
  (value in ['cpu', 'gpu', 'auto']) ? value : 'cpu'
}

def normalize_runtime_mode = { raw ->
  def value = (raw ?: 'auto').toString().trim().toLowerCase()
  (value in ['auto', 'manual']) ? value : 'auto'
}

def normalize_source_mode = { raw ->
  def value = (raw ?: 'auto').toString().trim().toLowerCase()
  (value in ['auto', 'oras', 'release', 'docker']) ? value : 'auto'
}

def as_boolean = { raw, boolean fallback = false ->
  if (raw == null) return fallback
  if (raw instanceof Boolean) return raw
  def value = raw.toString().trim().toLowerCase()
  if (value in ['true', '1', 'yes', 'y', 'on']) return true
  if (value in ['false', '0', 'no', 'n', 'off']) return false
  fallback
}

def detect_host_arch = { Map p ->
  def hostArch = normalize_arch.call(container_param_or.call(p, 'host_arch', 'auto'))
  if (!hostArch || hostArch == 'auto') {
    hostArch = normalize_arch.call(System.getProperty('os.arch'))
  }
  if (!(hostArch in ['amd64', 'arm64'])) hostArch = 'amd64'
  hostArch
}

def detect_nvidia_visible = {
  def is_positive = { String value -> value && !(value in ['none', 'void', 'no', 'false', '-1']) }
  def nvidia_visible = (System.getenv('NVIDIA_VISIBLE_DEVICES') ?: '').toString().trim().toLowerCase()
  def cuda_visible = (System.getenv('CUDA_VISIBLE_DEVICES') ?: '').toString().trim().toLowerCase()
  is_positive(nvidia_visible) || is_positive(cuda_visible)
}

def _container_warned_messages = [] as Set
def warn_container_once = { String message ->
  if (_container_warned_messages.add(message)) {
    println "WARN: ${message}"
  }
}

def resolve_compute_device = { Map p, String hostArch ->
  def requested = normalize_compute_device.call(container_param_or.call(p, 'compute_device', 'cpu'))
  def enableGpuOnArm64 = as_boolean.call(container_param_or.call(p, 'enable_gpu_on_arm64', false), false)

  if (requested == 'auto') {
    def gpuAllowed = hostArch == 'amd64' || (hostArch == 'arm64' && enableGpuOnArm64)
    return (gpuAllowed && detect_nvidia_visible.call()) ? 'gpu' : 'cpu'
  }

  if (requested == 'gpu' && hostArch == 'arm64' && !enableGpuOnArm64) {
    warn_container_once.call("compute_device='gpu' requested on arm64 but 'enable_gpu_on_arm64=false'. Falling back to CPU containers.")
    return 'cpu'
  }

  requested
}

def _release_reachability_cache = [:]
def release_asset_reachable = { String releaseUrl ->
  if (!releaseUrl) return false
  if (_release_reachability_cache.containsKey(releaseUrl)) {
    return _release_reachability_cache[releaseUrl] as boolean
  }
  def ok = false
  try {
    def escaped = releaseUrl.replace("'", "'\"'\"'")
    def proc = ['bash', '-lc', "curl -fsIL --max-time 12 '${escaped}' >/dev/null 2>&1"].execute()
    def finished = proc.waitFor(4, java.util.concurrent.TimeUnit.SECONDS)
    if (!finished) {
      proc.destroyForcibly()
      ok = false
    } else {
      ok = proc.exitValue() == 0
    }
  } catch (Throwable ignored) {
    ok = false
  }
  _release_reachability_cache[releaseUrl] = ok
  ok
}

def singularity_oras_ref = { String repo, String tag ->
  def cleanRepo = (repo ?: '').toString().trim()
  def cleanTag = (tag ?: '').toString().trim()
  if (!cleanRepo || !cleanTag) return ''
  "oras://${cleanRepo}:${cleanTag}"
}

def resolve_singularity_ref = { Map p, def baseDirObj, String role ->
  def runtimeMode = normalize_runtime_mode.call(container_param_or.call(p, 'runtime_image_mode', 'auto'))
  def legacyManualImage = (container_param_or.call(p, 'singularity_image', '') ?: '').toString().trim()
  def manualCpuImage = (container_param_or.call(p, 'cpu_container_image', '') ?: '').toString().trim()
  def manualGpuImage = (container_param_or.call(p, 'gpu_container_image', '') ?: '').toString().trim()

  if (role == 'gpu' && manualGpuImage) return manualGpuImage
  if (role == 'cpu' && manualCpuImage) return manualCpuImage
  if (runtimeMode == 'manual') {
    if (manualCpuImage) return manualCpuImage
    if (legacyManualImage) return legacyManualImage
  }

  def hostArch = detect_host_arch.call(p)
  def sourceMode = normalize_source_mode.call(container_param_or.call(p, 'singularity_image_source', 'auto'))
  def computeDevice = resolve_compute_device.call(p, hostArch)
  def gpuRequested = computeDevice == 'gpu'
  def enableGpuOnArm64 = as_boolean.call(container_param_or.call(p, 'enable_gpu_on_arm64', false), false)
  def gpuAllowed = hostArch == 'amd64' || (hostArch == 'arm64' && enableGpuOnArm64)
  def gpuRoleActive = role == 'gpu' && gpuRequested && gpuAllowed

  def repo = (container_param_or.call(p, 'container_repo', default_container_repo) ?: default_container_repo).toString().trim()
  if (!repo) repo = default_container_repo
  def cpuTagAmd64 = (container_param_or.call(p, 'container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
  if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
  def cpuTagArm64 = (container_param_or.call(p, 'container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
  if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
  def gpuTag = (container_param_or.call(p, 'container_gpu_tag', default_container_gpu_tag) ?: default_container_gpu_tag).toString().trim()
  if (!gpuTag) gpuTag = default_container_gpu_tag

  def selectedCpuTag = hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64
  def cpuDockerRef = "docker://${repo}:${selectedCpuTag}"
  def gpuDockerRef = "docker://${repo}:${gpuTag}"

  def releaseRepo = (container_param_or.call(p, 'singularity_release_repo', 'tkcaccia/CellPhenotyper') ?: 'tkcaccia/CellPhenotyper').toString().trim()
  def releaseTag = (container_param_or.call(p, 'singularity_release_tag', 'v2.2') ?: 'v2.2').toString().trim()
  def cpuAssetAmd64 = (container_param_or.call(p, 'singularity_cpu_asset_amd64', 'cellphenotyper-2.2-amd64.sif') ?: 'cellphenotyper-2.2-amd64.sif').toString().trim()
  def cpuAssetArm64 = (container_param_or.call(p, 'singularity_cpu_asset_arm64', 'cellphenotyper-2.2-arm64.sif') ?: 'cellphenotyper-2.2-arm64.sif').toString().trim()
  def gpuAssetAmd64 = (container_param_or.call(p, 'singularity_gpu_asset_amd64', 'cellphenotyper-2.2-gpu-amd64.sif') ?: 'cellphenotyper-2.2-gpu-amd64.sif').toString().trim()
  def gpuAssetArm64 = (container_param_or.call(p, 'singularity_gpu_asset_arm64', 'cellphenotyper-2.2-gpu-arm64.sif') ?: 'cellphenotyper-2.2-gpu-arm64.sif').toString().trim()
  def orasRepo = (container_param_or.call(p, 'singularity_oras_repo', repo) ?: repo).toString().trim()
  def cpuOrasTagAmd64 = (container_param_or.call(p, 'singularity_cpu_oras_tag_amd64', '2.2-sif-amd64') ?: '2.2-sif-amd64').toString().trim()
  def cpuOrasTagArm64 = (container_param_or.call(p, 'singularity_cpu_oras_tag_arm64', '2.2-sif-arm64') ?: '2.2-sif-arm64').toString().trim()
  def gpuOrasTagAmd64 = (container_param_or.call(p, 'singularity_gpu_oras_tag_amd64', '2.2-sif-gpu-amd64') ?: '2.2-sif-gpu-amd64').toString().trim()
  def gpuOrasTagArm64 = (container_param_or.call(p, 'singularity_gpu_oras_tag_arm64', '2.2-sif-gpu-arm64') ?: '2.2-sif-gpu-arm64').toString().trim()
  def localDir = (container_param_or.call(p, 'singularity_local_dir', '') ?: '').toString().trim()

  def pickFromAsset = { String assetName, String orasTag, String dockerFallbackRef ->
    if (sourceMode == 'docker') {
      return dockerFallbackRef
    }

    if (assetName) {
      def localCandidates = []
      if (localDir) localCandidates << new File(localDir, assetName)
      localCandidates << new File(baseDirObj.toString(), assetName)
      localCandidates << new File(baseDirObj.toString(), "singularity/${assetName}")
      for (f in localCandidates) {
        try {
          if (f.exists() && f.isFile()) return f.absolutePath
        } catch (Throwable ignored) {}
      }
    }

    def orasRef = singularity_oras_ref.call(orasRepo, orasTag)
    if (orasRef && sourceMode in ['auto', 'oras']) {
      return orasRef
    }
    if (sourceMode == 'oras') {
      warn_container_once.call("ORAS-hosted Singularity image metadata is incomplete for tag '${orasTag ?: 'unknown'}'.")
    }

    if (assetName && releaseRepo && releaseTag) {
      def releaseUrl = "https://github.com/${releaseRepo}/releases/download/${releaseTag}/${assetName}"
      if (release_asset_reachable.call(releaseUrl)) {
        return releaseUrl
      }
      if (sourceMode == 'release') {
        warn_container_once.call("Release-hosted Singularity image is not reachable: ${releaseUrl}")
      }
    } else if (sourceMode == 'release') {
      warn_container_once.call("Release-hosted Singularity image metadata is incomplete for asset '${assetName ?: 'unknown'}'.")
    }

    dockerFallbackRef
  }

  def cpuAsset = hostArch == 'amd64' ? cpuAssetAmd64 : cpuAssetArm64
  def cpuOrasTag = hostArch == 'amd64' ? cpuOrasTagAmd64 : cpuOrasTagArm64
  def cpuResolved = pickFromAsset.call(cpuAsset, cpuOrasTag, cpuDockerRef)
  if (role != 'gpu' || !gpuRequested) return cpuResolved

  if (!gpuAllowed) {
    warn_container_once.call("GPU process container requested but arm64 GPU execution is disabled. Falling back to CPU container.")
    return cpuResolved
  }

  def gpuAsset = hostArch == 'amd64' ? gpuAssetAmd64 : gpuAssetArm64
  def gpuOrasTag = hostArch == 'amd64' ? gpuOrasTagAmd64 : gpuOrasTagArm64
  if (hostArch == 'arm64') {
    if (sourceMode == 'docker') {
      warn_container_once.call("singularity_image_source='docker' on arm64 GPU would select an amd64 image by default; falling back to CPU container.")
      return cpuResolved
    }
    def gpuResolved = pickFromAsset.call(gpuAsset, gpuOrasTag, '')
    if (gpuResolved) return gpuResolved
    warn_container_once.call("No compatible arm64 GPU Singularity image found (expected asset '${gpuAsset}'). Falling back to CPU container.")
    return cpuResolved
  }

  def gpuResolved = pickFromAsset.call(gpuAsset, gpuOrasTag, gpuDockerRef)
  gpuResolved ?: cpuResolved
}

def strip_docker_prefix = { String imageRef ->
  def ref = (imageRef ?: '').toString().trim()
  ref.startsWith('docker://') ? ref.replaceFirst('^docker://', '') : ref
}

def resolve_docker_ref = { Map p, String role ->
  def runtimeMode = normalize_runtime_mode.call(container_param_or.call(p, 'runtime_image_mode', 'auto'))
  def legacyManualImage = strip_docker_prefix.call((container_param_or.call(p, 'docker_image', '') ?: '').toString().trim())
  def manualCpuImage = strip_docker_prefix.call((container_param_or.call(p, 'cpu_container_image', '') ?: '').toString().trim())
  def manualGpuImage = strip_docker_prefix.call((container_param_or.call(p, 'gpu_container_image', '') ?: '').toString().trim())

  if (role == 'gpu' && manualGpuImage) return manualGpuImage
  if (role == 'cpu' && manualCpuImage) return manualCpuImage
  if (runtimeMode == 'manual') {
    if (manualCpuImage) return manualCpuImage
    if (legacyManualImage && legacyManualImage != 'cellphenotyper:full-cpu') return legacyManualImage
  }

  def hostArch = detect_host_arch.call(p)
  def computeDevice = resolve_compute_device.call(p, hostArch)
  def gpuRequested = computeDevice == 'gpu'
  def enableGpuOnArm64 = as_boolean.call(container_param_or.call(p, 'enable_gpu_on_arm64', false), false)
  def gpuAllowed = hostArch == 'amd64' || (hostArch == 'arm64' && enableGpuOnArm64)

  def repo = (container_param_or.call(p, 'container_repo', default_container_repo) ?: default_container_repo).toString().trim()
  if (!repo) repo = default_container_repo
  def cpuTagAmd64 = (container_param_or.call(p, 'container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
  if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
  def cpuTagArm64 = (container_param_or.call(p, 'container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
  if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
  def gpuTag = (container_param_or.call(p, 'container_gpu_tag', default_container_gpu_tag) ?: default_container_gpu_tag).toString().trim()
  if (!gpuTag) gpuTag = default_container_gpu_tag

  def cpuRef = "${repo}:${hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64}"
  if (role != 'gpu' || !gpuRequested) return cpuRef

  if (!gpuAllowed) {
    warn_container_once.call("GPU process container requested but arm64 GPU execution is disabled. Falling back to CPU image.")
    return cpuRef
  }
  if (hostArch == 'arm64') {
    warn_container_once.call("No default arm64 GPU docker tag is configured; GPU processes fall back to CPU image unless --gpu_container_image is provided.")
    return cpuRef
  }

  "${repo}:${gpuTag}"
}

params {
  image_input                    = null
  folder_input                   = null
  roi_geojson                    = null
  outdir_base                    = 'results'

  run_full_pipeline              = true
  start_point                    = 'convert'
  end_point                      = 'auto'
  tissue_mask_from_input         = false
  compute_device                 = 'cpu'   // cpu | gpu | auto
  host_arch                      = 'auto'  // auto | amd64 | arm64
  enable_gpu_on_arm64            = false   // when true, allow gpu selection on arm64 if a compatible container exists
  enable_stardist_gpu_on_arm64   = false   // when true, allow StarDist process to use GPU container on arm64
  runtime_image_mode             = 'auto'  // auto | manual
  uni2_device_auto               = 'cpu'

  container_repo                 = default_container_repo
  container_cpu_tag              = default_container_cpu_tag   // legacy generic fallback; arch tags below are authoritative
  container_cpu_tag_amd64        = default_container_cpu_tag_amd64
  container_cpu_tag_arm64        = default_container_cpu_tag_arm64
  container_gpu_tag              = default_container_gpu_tag
  singularity_image_source       = 'auto'   // auto | oras | release | docker
  singularity_oras_repo          = default_container_repo
  singularity_cpu_oras_tag_amd64 = '2.2-sif-amd64'
  singularity_cpu_oras_tag_arm64 = '2.2-sif-arm64'
  singularity_gpu_oras_tag_amd64 = '2.2-sif-gpu-amd64'
  singularity_gpu_oras_tag_arm64 = '2.2-sif-gpu-arm64'
  singularity_release_repo       = 'tkcaccia/CellPhenotyper'
  singularity_release_tag        = 'v2.2'
  singularity_cpu_asset_amd64    = 'cellphenotyper-2.2-amd64.sif'
  singularity_cpu_asset_arm64    = 'cellphenotyper-2.2-arm64.sif'

}

process {
  executor = 'local'
  shell = ['/bin/bash', '-euo', 'pipefail']

  withLabel: io_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_medium {
    errorStrategy = 'retry'
    maxRetries = 1
  }
  withLabel: compute_heavy {
    errorStrategy = 'retry'
    maxRetries = 1
  }
}

def singularity_bind_targets = [
  params.image_input,
  params.folder_input,
  params.roi_geojson,
  params.outdir_base,
  params.hf_home,
  params.hf_hub_cache,
  params.hf_token_env_file,
  params.stardist_keras_home,
  params.stardist_pretrained_zip,
  params.grandqc_cache_dir,
  params.singularity_local_dir
].collectMany { raw ->
  if (raw == null) {
    return []
  }
  def value = raw.toString().trim()
  if (!value) {
    return []
  }
  def file = new File(value)
  def target = file.isDirectory() ? file : file.getParentFile()
  if (target == null) {
    return []
  }
  def targets = [target.exists() ? target.getCanonicalPath() : target.getAbsolutePath()]
  if (file.isDirectory()) {
    file.eachFile { child ->
      try {
        if (java.nio.file.Files.isSymbolicLink(child.toPath())) {
          def resolved = child.getCanonicalFile()
          def resolvedTarget = resolved.isDirectory() ? resolved : resolved.getParentFile()
          if (resolvedTarget != null) {
            targets << resolvedTarget.getCanonicalPath()
          }
        }
      } catch (ignored) {
        // Best-effort bind expansion; invalid symlinks are handled by the pipeline input checks.
      }
    }
  }
  targets
}.findAll { it }.unique().sort()

profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.cacheDir = (params.singularity_cache_dir ?: "${baseDir}/.apptainer_cache").toString()
    def singularityBaseRunOptions = (((params.containsKey('compute_device') ? params.compute_device : 'cpu') ?: 'cpu').toString().trim().toLowerCase() == 'gpu') ? '--nv' : ''
    def singularityBindRunOptions = singularity_bind_targets.collect { "-B ${it}" }.join(' ')
    singularity.runOptions = [singularityBaseRunOptions, singularityBindRunOptions].findAll { it }.join(' ')
    process.container = {
      def paramOr = { String key, def fallback ->
        def value = params.containsKey(key) ? params[key] : null
        if (value == null) return fallback
        if (value instanceof CharSequence && value.toString().trim().isEmpty()) return fallback
        value
      }
      def normalizeArch = { raw ->
        def value = (raw ?: '').toString().trim().toLowerCase()
        if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
        if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
        if (value == 'auto') return 'auto'
        value
      }
      def normalizeSource = { raw ->
        def value = (raw ?: 'auto').toString().trim().toLowerCase()
        (value in ['auto', 'oras', 'release', 'docker']) ? value : 'auto'
      }
      def runtimeMode = (paramOr('runtime_image_mode', 'auto') ?: 'auto').toString().trim().toLowerCase()
      if (!(runtimeMode in ['auto', 'manual'])) runtimeMode = 'auto'

      def legacyManual = (paramOr('singularity_image', '') ?: '').toString().trim()
      def cpuManual = (paramOr('cpu_container_image', '') ?: '').toString().trim()
      if (cpuManual) return cpuManual
      if (runtimeMode == 'manual' && legacyManual) return legacyManual

      def hostArch = normalizeArch(paramOr('host_arch', 'auto'))
      if (!hostArch || hostArch == 'auto') hostArch = normalizeArch(System.getProperty('os.arch'))
      if (!(hostArch in ['amd64', 'arm64'])) hostArch = 'amd64'

      def repo = (paramOr('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
      if (!repo) repo = default_container_repo
      def cpuTagAmd64 = (paramOr('container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
      if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
      def cpuTagArm64 = (paramOr('container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
      if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
      def cpuTag = hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64
      def cpuDockerRef = "docker://${repo}:${cpuTag}"

      def sourceMode = normalizeSource(paramOr('singularity_image_source', 'auto'))
      if (sourceMode == 'docker') return cpuDockerRef

      def orasRepo = (paramOr('singularity_oras_repo', repo) ?: repo).toString().trim()
      def cpuOrasTagAmd64 = (paramOr('singularity_cpu_oras_tag_amd64', '2.4-sif-amd64') ?: '2.4-sif-amd64').toString().trim()
      def cpuOrasTagArm64 = (paramOr('singularity_cpu_oras_tag_arm64', '2.4-sif-arm64') ?: '2.4-sif-arm64').toString().trim()
      def releaseRepo = (paramOr('singularity_release_repo', 'tkcaccia/CellPhenotyper') ?: 'tkcaccia/CellPhenotyper').toString().trim()
      def releaseTag = (paramOr('singularity_release_tag', 'v2.4') ?: 'v2.4').toString().trim()
      def cpuAssetAmd64 = (paramOr('singularity_cpu_asset_amd64', 'cellphenotyper-2.4-amd64.sif') ?: 'cellphenotyper-2.4-amd64.sif').toString().trim()
      def cpuAssetArm64 = (paramOr('singularity_cpu_asset_arm64', 'cellphenotyper-2.4-arm64.sif') ?: 'cellphenotyper-2.4-arm64.sif').toString().trim()
      def cpuAsset = hostArch == 'amd64' ? cpuAssetAmd64 : cpuAssetArm64
      def cpuOrasTag = hostArch == 'amd64' ? cpuOrasTagAmd64 : cpuOrasTagArm64
      def localDir = (paramOr('singularity_local_dir', '') ?: '').toString().trim()

      def localCandidates = []
      if (localDir) localCandidates << new File(localDir, cpuAsset)
      localCandidates << new File(baseDir.toString(), cpuAsset)
      localCandidates << new File(baseDir.toString(), "singularity/${cpuAsset}")
      for (f in localCandidates) {
        try {
          if (f.exists() && f.isFile()) return f.absolutePath
        } catch (Throwable ignored) {}
      }

      def orasRef = singularity_oras_ref.call(orasRepo, cpuOrasTag)
      if (orasRef && sourceMode in ['auto', 'oras']) return orasRef
      if (sourceMode == 'oras') {
        println "WARN: ORAS-hosted Singularity image metadata is incomplete for tag '${cpuOrasTag ?: 'unknown'}'; falling back to ${cpuDockerRef}"
      }

      if (releaseRepo && releaseTag && cpuAsset) {
        def releaseUrl = "https://github.com/${releaseRepo}/releases/download/${releaseTag}/${cpuAsset}"
        try {
          def escaped = releaseUrl.replace("'", "'\"'\"'")
          def proc = ['bash', '-lc', "curl -fsIL --max-time 12 '${escaped}' >/dev/null 2>&1"].execute()
          def finished = proc.waitFor(3, java.util.concurrent.TimeUnit.SECONDS)
          if (finished && proc.exitValue() == 0) return releaseUrl
        } catch (Throwable ignored) {}
        if (sourceMode == 'release') {
          println "WARN: Release-hosted Singularity image is not reachable (${releaseUrl}); falling back to ${cpuDockerRef}"
        }
      }

      cpuDockerRef
    }
    process {
      withLabel: gpu_capable {
        container = {
          def paramOr = { String key, def fallback ->
            def value = params.containsKey(key) ? params[key] : null
            if (value == null) return fallback
            if (value instanceof CharSequence && value.toString().trim().isEmpty()) return fallback
            value
          }
          def normalizeArch = { raw ->
            def value = (raw ?: '').toString().trim().toLowerCase()
            if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
            if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
            if (value == 'auto') return 'auto'
            value
          }
          def normalizeSource = { raw ->
            def value = (raw ?: 'auto').toString().trim().toLowerCase()
            (value in ['auto', 'oras', 'release', 'docker']) ? value : 'auto'
          }
          def parseBool = { raw ->
            def value = (raw ?: false).toString().trim().toLowerCase()
            value in ['true', '1', 'yes', 'y', 'on']
          }
          def runtimeMode = (paramOr('runtime_image_mode', 'auto') ?: 'auto').toString().trim().toLowerCase()
          if (!(runtimeMode in ['auto', 'manual'])) runtimeMode = 'auto'

          def legacyManual = (paramOr('singularity_image', '') ?: '').toString().trim()
          def cpuManual = (paramOr('cpu_container_image', '') ?: '').toString().trim()
          def gpuManual = (paramOr('gpu_container_image', '') ?: '').toString().trim()
          if (runtimeMode == 'manual' && legacyManual) return legacyManual

          def hostArch = normalizeArch(paramOr('host_arch', 'auto'))
          if (!hostArch || hostArch == 'auto') hostArch = normalizeArch(System.getProperty('os.arch'))
          if (!(hostArch in ['amd64', 'arm64'])) hostArch = 'amd64'

          def repo = (paramOr('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
          if (!repo) repo = default_container_repo
          def cpuTagAmd64 = (paramOr('container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
          if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
          def cpuTagArm64 = (paramOr('container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
          if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
          def cpuFallback = cpuManual ?: (runtimeMode == 'manual' && legacyManual ? legacyManual : "docker://${repo}:${hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64}")

          def computeDevice = (paramOr('compute_device', 'cpu') ?: 'cpu').toString().trim().toLowerCase()
          if (!(computeDevice in ['cpu', 'gpu', 'auto'])) computeDevice = 'cpu'
          if (computeDevice == 'auto') computeDevice = 'cpu'
          def enableGpuArm64 = parseBool(paramOr('enable_gpu_on_arm64', false))
          def enableStardistGpuArm64 = parseBool(paramOr('enable_stardist_gpu_on_arm64', false))
          def gpuAllowed = hostArch == 'amd64' || (hostArch == 'arm64' && enableGpuArm64)
          if (hostArch == 'arm64' && task.process == 'RUN_STARDIST_ROI_SEGMENTATION' && !enableStardistGpuArm64) {
            println "WARN: RUN_STARDIST_ROI_SEGMENTATION uses CPU container on arm64 by default (set --enable_stardist_gpu_on_arm64 true to override)."
            return cpuFallback
          }
          if (computeDevice != 'gpu' || !gpuAllowed) {
            if (computeDevice == 'gpu' && hostArch == 'arm64' && !enableGpuArm64) {
              println "WARN: GPU requested on arm64 but enable_gpu_on_arm64=false. Using CPU container for ${task.process}."
            }
            return cpuFallback
          }
          if (gpuManual) return gpuManual

          def gpuTag = (paramOr('container_gpu_tag', default_container_gpu_tag) ?: default_container_gpu_tag).toString().trim()
          if (!gpuTag) gpuTag = default_container_gpu_tag
          def gpuDockerRef = "docker://${repo}:${gpuTag}"

          def sourceMode = normalizeSource(paramOr('singularity_image_source', 'auto'))
          if (sourceMode == 'docker' && hostArch == 'arm64') {
            println "WARN: arm64 GPU run with singularity_image_source=docker would select amd64 GPU image; using CPU container for ${task.process}."
            return cpuFallback
          }
          if (sourceMode == 'docker') return gpuDockerRef

          def orasRepo = (paramOr('singularity_oras_repo', repo) ?: repo).toString().trim()
          def gpuOrasTagAmd64 = (paramOr('singularity_gpu_oras_tag_amd64', '2.4-sif-gpu-amd64') ?: '2.4-sif-gpu-amd64').toString().trim()
          def gpuOrasTagArm64 = (paramOr('singularity_gpu_oras_tag_arm64', '2.4-sif-gpu-arm64') ?: '2.4-sif-gpu-arm64').toString().trim()
          def releaseRepo = (paramOr('singularity_release_repo', 'tkcaccia/CellPhenotyper') ?: 'tkcaccia/CellPhenotyper').toString().trim()
          def releaseTag = (paramOr('singularity_release_tag', 'v2.4') ?: 'v2.4').toString().trim()
          def gpuAssetAmd64 = (paramOr('singularity_gpu_asset_amd64', 'cellphenotyper-2.4-gpu-amd64.sif') ?: 'cellphenotyper-2.4-gpu-amd64.sif').toString().trim()
          def gpuAssetArm64 = (paramOr('singularity_gpu_asset_arm64', 'cellphenotyper-2.4-gpu-arm64.sif') ?: 'cellphenotyper-2.4-gpu-arm64.sif').toString().trim()
          def gpuAsset = hostArch == 'amd64' ? gpuAssetAmd64 : gpuAssetArm64
          def gpuOrasTag = hostArch == 'amd64' ? gpuOrasTagAmd64 : gpuOrasTagArm64
          def localDir = (paramOr('singularity_local_dir', '') ?: '').toString().trim()

          def localCandidates = []
          if (localDir) localCandidates << new File(localDir, gpuAsset)
          localCandidates << new File(baseDir.toString(), gpuAsset)
          localCandidates << new File(baseDir.toString(), "singularity/${gpuAsset}")
          for (f in localCandidates) {
            try {
              if (f.exists() && f.isFile()) return f.absolutePath
            } catch (Throwable ignored) {}
          }

          def orasRef = singularity_oras_ref.call(orasRepo, gpuOrasTag)
          if (orasRef && sourceMode in ['auto', 'oras']) return orasRef
          if (sourceMode == 'oras' && hostArch == 'arm64') {
            println "WARN: arm64 GPU ORAS Singularity tag is not configured; using CPU container for ${task.process}."
          } else if (sourceMode == 'oras') {
            println "WARN: ORAS-hosted GPU Singularity image metadata is incomplete for tag '${gpuOrasTag ?: 'unknown'}'; falling back to ${gpuDockerRef}"
          }

          if (releaseRepo && releaseTag && gpuAsset) {
            def releaseUrl = "https://github.com/${releaseRepo}/releases/download/${releaseTag}/${gpuAsset}"
            try {
              def escaped = releaseUrl.replace("'", "'\"'\"'")
              def proc = ['bash', '-lc', "curl -fsIL --max-time 12 '${escaped}' >/dev/null 2>&1"].execute()
              def finished = proc.waitFor(3, java.util.concurrent.TimeUnit.SECONDS)
              if (finished && proc.exitValue() == 0) return releaseUrl
            } catch (Throwable ignored) {}
            if (sourceMode == 'release' || hostArch == 'arm64') {
              println "WARN: arm64 GPU Singularity asset is not reachable (${releaseUrl}); using CPU container for ${task.process}."
            }
          }

          if (hostArch == 'arm64') {
            println "WARN: No arm64 GPU Singularity image found; using CPU container for ${task.process}."
            return cpuFallback
          }
          gpuDockerRef
        }
      }
    }
  }

  docker {
    docker.enabled = true
    docker.runOptions = (((params.containsKey('compute_device') ? params.compute_device : 'cpu') ?: 'cpu').toString().trim().toLowerCase() == 'gpu') ? '--gpus all' : ''
    process.container = {
      def paramOr = { String key, def fallback ->
        def value = params.containsKey(key) ? params[key] : null
        if (value == null) return fallback
        if (value instanceof CharSequence && value.toString().trim().isEmpty()) return fallback
        value
      }
      def normalizeArch = { raw ->
        def value = (raw ?: '').toString().trim().toLowerCase()
        if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
        if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
        value
      }
      def hostArch = normalizeArch(paramOr('host_arch', 'auto'))
      if (!hostArch || hostArch == 'auto') hostArch = normalizeArch(System.getProperty('os.arch'))
      if (!(hostArch in ['amd64', 'arm64'])) hostArch = 'amd64'

      def manualCpu = (paramOr('cpu_container_image', '') ?: '').toString().replaceFirst('^docker://', '').trim()
      if (manualCpu) return manualCpu
      def runtimeMode = (paramOr('runtime_image_mode', 'auto') ?: 'auto').toString().toLowerCase()
      if (runtimeMode == 'manual') {
        def legacy = (paramOr('docker_image', '') ?: '').toString().replaceFirst('^docker://', '').trim()
        if (legacy && legacy != 'cellphenotyper:full-cpu') return legacy
      }
      def repo = (paramOr('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
      if (!repo) repo = default_container_repo
      def cpuTagAmd64 = (paramOr('container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
      if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
      def cpuTagArm64 = (paramOr('container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
      if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
      def cpuTag = hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64
      "${repo}:${cpuTag}"
    }
    process {
      withLabel: gpu_capable {
        container = {
          def paramOr = { String key, def fallback ->
            def value = params.containsKey(key) ? params[key] : null
            if (value == null) return fallback
            if (value instanceof CharSequence && value.toString().trim().isEmpty()) return fallback
            value
          }
          def normalizeArch = { raw ->
            def value = (raw ?: '').toString().trim().toLowerCase()
            if (value in ['x86_64', 'amd64', 'x64', 'x86-64']) return 'amd64'
            if (value in ['aarch64', 'arm64', 'arm64v8', 'arm64/v8', 'armv8', 'armv8l']) return 'arm64'
            if (value == 'auto') return 'auto'
            value
          }
          def parseBool = { raw ->
            def value = (raw ?: false).toString().trim().toLowerCase()
            value in ['true', '1', 'yes', 'y', 'on']
          }
          def manualGpu = (paramOr('gpu_container_image', '') ?: '').toString().replaceFirst('^docker://', '').trim()
          def manualCpu = (paramOr('cpu_container_image', '') ?: '').toString().replaceFirst('^docker://', '').trim()
          def hostArch = normalizeArch(paramOr('host_arch', 'auto'))
          if (!hostArch || hostArch == 'auto') hostArch = normalizeArch(System.getProperty('os.arch'))
          if (!(hostArch in ['amd64', 'arm64'])) hostArch = 'amd64'
          def repo = (paramOr('container_repo', default_container_repo) ?: default_container_repo).toString().trim()
          if (!repo) repo = default_container_repo
          def cpuTagAmd64 = (paramOr('container_cpu_tag_amd64', default_container_cpu_tag_amd64) ?: default_container_cpu_tag_amd64).toString().trim()
          if (!cpuTagAmd64) cpuTagAmd64 = default_container_cpu_tag_amd64
          def cpuTagArm64 = (paramOr('container_cpu_tag_arm64', default_container_cpu_tag_arm64) ?: default_container_cpu_tag_arm64).toString().trim()
          if (!cpuTagArm64) cpuTagArm64 = default_container_cpu_tag_arm64
          def cpuFallback = manualCpu ?: "${repo}:${hostArch == 'amd64' ? cpuTagAmd64 : cpuTagArm64}"
          def computeDevice = (paramOr('compute_device', 'cpu') ?: 'cpu').toString().trim().toLowerCase()
          if (!(computeDevice in ['cpu', 'gpu', 'auto'])) computeDevice = 'cpu'
          if (computeDevice == 'auto') computeDevice = 'cpu'
          if (computeDevice != 'gpu') return cpuFallback
          def enableStardistGpuArm64 = parseBool(paramOr('enable_stardist_gpu_on_arm64', false))
          if (hostArch == 'arm64' && task.process == 'RUN_STARDIST_ROI_SEGMENTATION' && !enableStardistGpuArm64) {
            println "WARN: RUN_STARDIST_ROI_SEGMENTATION uses CPU container on arm64 by default (set --enable_stardist_gpu_on_arm64 true to override)."
            return cpuFallback
          }
          def enableGpuArm64 = parseBool(paramOr('enable_gpu_on_arm64', false))
          if (hostArch == 'arm64' && !enableGpuArm64) return cpuFallback
          if (manualGpu) return manualGpu
          if (hostArch == 'arm64') {
            println "WARN: No default arm64 GPU Docker tag configured; using CPU image for ${task.process}."
            return cpuFallback
          }
          def gpuTag = (paramOr('container_gpu_tag', default_container_gpu_tag) ?: default_container_gpu_tag).toString().trim()
          if (!gpuTag) gpuTag = default_container_gpu_tag
          "${repo}:${gpuTag}"
        }
      }
    }
  }

  debug {
    params {
      run_full_pipeline = false
      tissue_mask_from_input = true
      write_full_labels = false
      convert_cpus = 2
      tissue_mask_cpus = 2
    }
    process {
      withLabel: io_heavy {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_medium {
        cpus = 2
        memory = '4 GB'
        time = '1h'
      }
      withLabel: compute_heavy {
        cpus = 2
        memory = '8 GB'
        time = '2h'
      }
    }
  }
}

manifest {
  name = 'tkcaccia/CellPhenotyper'
  mainScript = 'main.nf'
  defaultBranch = 'main'
}

report {
  enabled = true
  file = "${params.outdir_base}/report_pipeline.html"
  overwrite = true
}

trace {
  enabled = true
  file = "${params.outdir_base}/00_execution/trace.tsv"
  overwrite = true
}

timeline {
  enabled = true
  file = "${params.outdir_base}/00_execution/timeline.html"
  overwrite = true
}

dag {
  enabled = true
  file = "${params.outdir_base}/00_execution/dag.html"
  overwrite = true
}

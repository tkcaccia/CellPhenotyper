{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/tkcaccia/CellPhenotyper/main/nextflow_schema.json",
  "title": "CellPhenotyper pipeline parameters",
  "description": "Schema for scientific-route, validation, input-QC, hardware, uncertainty and publication-critical parameters. Advanced stage resource overrides remain accepted and are documented in PARAMETERS.md.",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "input_output_options": {
      "title": "Input and output",
      "description": "Select one image or a folder of images and define the durable output location.",
      "type": "object",
      "properties": {
        "folder_input": {
          "type": ["string", "null"],
          "description": "Folder containing supported H&E image files and optional matching GeoJSON files. Takes precedence over image_input."
        },
        "image_input": {
          "type": ["string", "null"],
          "description": "Single H&E image path. Use folder_input for a cohort."
        },
        "roi_geojson": {
          "type": ["string", "null"],
          "description": "Optional level-0 pixel Polygon/MultiPolygon GeoJSON paired with image_input."
        },
        "require_matching_roi": {
          "type": "boolean",
          "default": false,
          "description": "Reject or skip inputs without a matching ROI instead of generating a full-image ROI."
        },
        "outdir_base": {
          "type": "string",
          "minLength": 1,
          "default": "results",
          "description": "Durable output root."
        },
        "publish_dir_mode": {
          "type": "string",
          "enum": ["copy", "rellink"],
          "default": "copy",
          "description": "Use copy when work/ may be deleted; rellink requires retaining the Nextflow cache."
        },
        "run_full_pipeline": {"type": "boolean", "default": true},
        "start_point": {"$ref": "#/definitions/stage_name"},
        "end_point": {
          "oneOf": [
            {"const": "auto"},
            {"$ref": "#/definitions/stage_name"}
          ],
          "default": "auto"
        }
      }
    },
    "scientific_design_options": {
      "title": "Scientific purpose and evidence",
      "description": "Declare one primary intended use and its evidence level before inspecting results.",
      "type": "object",
      "properties": {
        "analysis_intent": {
          "type": "string",
          "enum": ["exploratory", "cell_segmentation", "cell_phenotyping", "tissue_domain_discovery", "virtual_staining", "outcome_prediction"],
          "default": "exploratory",
          "description": "Primary scientific question. Routes have different observation and statistical units."
        },
        "study_manifest": {
          "type": ["string", "null"],
          "description": "Optional JSON declaration based on resources/study_manifest.template.json."
        },
        "evidence_gate_mode": {
          "type": "string",
          "enum": ["off", "warn", "fail"],
          "default": "warn",
          "description": "Use fail for a locked validation run; passing verifies declarations, not scientific validity."
        }
      }
    },
    "runtime_options": {
      "title": "Hardware and runtime",
      "description": "Hardware tuning may change safe batch/concurrency settings but not scientific behavior.",
      "type": "object",
      "properties": {
        "compute_device": {"type": "string", "enum": ["auto", "cpu", "gpu"], "default": "auto"},
        "host_arch": {"type": "string", "enum": ["auto", "amd64", "arm64"], "default": "auto"},
        "runtime_image_mode": {"type": "string", "enum": ["auto", "manual"], "default": "auto"},
        "hardware_auto": {"type": "boolean", "default": true},
        "hardware_profile": {"type": "string", "enum": ["auto", "conservative", "balanced", "aggressive"], "default": "auto"},
        "max_cpus": {"$ref": "#/definitions/auto_positive_integer"},
        "max_memory_gb": {"$ref": "#/definitions/auto_positive_integer"},
        "max_parallel_tasks": {"$ref": "#/definitions/auto_positive_integer"},
        "storage_preflight_mode": {
          "type": "string",
          "enum": ["off", "warn", "fail"],
          "default": "fail",
          "description": "Estimate per-filesystem output, work, cache and restart demand before scheduling image stages."
        },
        "storage_min_free_gib": {"type": "number", "minimum": 0, "default": 20.0},
        "storage_safety_factor": {"type": "number", "minimum": 1, "default": 1.25},
        "storage_restart_duplication_factor": {"type": "number", "minimum": 0, "default": 1.0},
        "storage_source_expansion_factor": {"type": "number", "minimum": 1, "default": 8.0},
        "gpu_scheduler_enable": {"type": "boolean", "default": true},
        "gpu_memory_reserve_gb": {"type": "number", "minimum": 0, "default": 2.0},
        "gpu_max_tasks_per_device": {"type": "integer", "minimum": 0, "default": 0}
      }
    },
    "input_qc_options": {
      "title": "Image and ROI integrity",
      "description": "Strict defaults prevent uncalibrated or mismatched images and annotations from reaching learned stages.",
      "type": "object",
      "properties": {
        "input_resolution_check": {"type": "boolean", "default": true},
        "input_resolution_strict": {"type": "boolean", "default": true},
        "input_resolution_min_mpp": {"type": "number", "exclusiveMinimum": 0, "default": 0.05},
        "input_resolution_max_mpp": {"type": "number", "exclusiveMinimum": 0, "default": 0.5},
        "input_resolution_cell_target_mpp": {"type": "number", "exclusiveMinimum": 0, "default": 0.25},
        "input_resolution_max_anisotropy_fraction": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.05},
        "input_resolution_max_conversion_drift_fraction": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.02},
        "input_resolution_max_metadata_conflict_fraction": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.02},
        "input_resolution_override_mpp": {
          "type": "number",
          "minimum": 0,
          "default": 0.0,
          "description": "Use only after independent verification of incorrect source metadata."
        },
        "input_hash_enable": {"type": "boolean", "default": true},
        "input_require_rgb": {"type": "boolean", "default": true},
        "input_require_pyramid": {"type": "boolean", "default": true},
        "roi_validation_mode": {"type": "string", "enum": ["fail", "warn"], "default": "fail"},
        "roi_bounds_tolerance_px2": {"type": "number", "minimum": 0, "default": 0.000001},
        "grandqc_enable": {
          "type": "boolean",
          "default": true,
          "description": "GrandQC is mandatory for every route extending past conversion."
        },
        "grandqc_artifact_mpp_model": {
          "oneOf": [
            {"const": "auto"},
            {"type": "number", "enum": [1.0, 1.5, 2.0]},
            {"type": "string", "enum": ["1.0", "1.5", "2.0"]}
          ],
          "default": "auto"
        },
        "grandqc_artifact_overlap_fraction": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0.5}
      }
    },
    "cell_options": {
      "title": "Cell identification and TMA",
      "type": "object",
      "properties": {
        "cell_detection_mode": {
          "type": "string",
          "enum": ["consensus", "stardist"],
          "default": "consensus",
          "description": "Scientific detector-population choice; hardware must not change it."
        },
        "cell_consensus_fusion_acceptance_policy": {
          "type": "string",
          "enum": ["broad_pair", "any_two"],
          "default": "broad_pair",
          "description": "broad_pair is the role-aware default; any_two is a legacy sensitivity analysis."
        },
        "cell_consensus_match_radius_um": {"type": "number", "exclusiveMinimum": 0, "default": 4.0},
        "stardist_prob": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.52},
        "stardist_nms": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.28},
        "stardist_min_area": {"type": "integer", "minimum": 0, "default": 120},
        "tma_enable": {"type": "boolean", "default": true},
        "tma_min_spots": {"type": "integer", "minimum": 2, "default": 4},
        "full_format": {"type": "string", "enum": ["zarr", "tif"], "default": "zarr"}
      }
    },
    "gigatime_options": {
      "title": "GigaTIME virtual markers",
      "type": "object",
      "properties": {
        "gigatime_enable": {"type": "boolean", "default": true},
        "gigatime_target_mpp": {"type": "number", "exclusiveMinimum": 0, "default": 0.25},
        "gigatime_strict_target_mpp": {"type": "boolean", "default": true},
        "gigatime_output_format": {"type": "string", "enum": ["zarr", "ome_tiff", "none"], "default": "zarr"},
        "gigatime_output_dtype": {"type": "string", "enum": ["uint8", "uint16", "float32"], "default": "uint8"},
        "gigatime_output_channels": {"type": "string", "minLength": 1, "default": "DAPI,PD-1,CD3,CD8,PD-L1"},
        "gigatime_output_pyramid": {"type": "boolean", "default": true},
        "gigatime_export_ometiff": {"type": "boolean", "default": true},
        "gigatime_skip_background_blocks": {
          "type": "boolean",
          "default": false,
          "description": "Experimental only; false is required for the validated continuity path."
        },
        "gigatime_seam_qc_mode": {"type": "string", "enum": ["off", "warn", "fail"], "default": "fail"},
        "gigatime_seam_qc_max_p95_excess": {"type": "number", "minimum": 0, "default": 0.1},
        "gigatime_seam_qc_min_affected_fraction": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.05},
        "gigatime_nuclear_qc_mode": {"type": "string", "enum": ["warn", "fail"], "default": "fail"},
        "gigatime_nuclear_qc_min_auc": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.7},
        "gigatime_nuclear_qc_min_dice": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.35},
        "gigatime_nuclear_qc_min_edge_ratio": {"type": "number", "minimum": 0, "default": 0.65},
        "marker_quantification_enable": {"type": "boolean", "default": true},
        "gigatime_kodama_enable": {"type": "boolean", "default": true}
      }
    },
    "representation_options": {
      "title": "Virchow2 tissue tiles, KODAMA and clustering",
      "type": "object",
      "properties": {
        "uni2_sampling_mode": {
          "type": "string",
          "const": "grid",
          "default": "grid",
          "description": "Disjoint, calibrated Virchow2 tissue tiles are the sole tile-analysis route."
        },
        "uni2_encoder": {"type": "string", "const": "virchow2", "default": "virchow2"},
        "uni2_target_mpp": {"type": "number", "const": 0.5, "default": 0.5},
        "uni2_tile_size": {"type": "integer", "const": 224, "default": 224},
        "uni2_inner_square_fixed_px": {"type": "integer", "minimum": 1, "default": 90},
        "uni2_include_inner_square": {"type": "boolean", "const": false, "default": false},
        "uni2_fuse_tile_inner_square": {"type": "boolean", "const": false, "default": false},
        "uni2_use_roi_crop": {"type": "boolean", "default": true},
        "uni2_paired_inner_square_mode": {"type": "string", "enum": ["token_subset", "masked_forward"], "default": "token_subset"},
        "uni2_mask_context_mode": {"type": "string", "enum": ["none", "label", "inner_square", "label_and_inner_square"], "default": "label"},
        "kodama_embedding_mode": {"type": "string", "const": "tile", "default": "tile"},
        "virchow2_checkpoint": {"type": "string"},
        "bora_classifier_model": {"type": "string"},
        "bora_source": {"type": "string"},
        "kodama_dims_to_run": {"type": "integer", "minimum": 2, "default": 20},
        "kodama_landmarks": {"type": "integer", "minimum": 2, "default": 10000},
        "cluster_algorithm": {"type": "string", "enum": ["leiden", "louvain", "walktrap"], "default": "leiden"},
        "cluster_target_clusters": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero preserves graph-derived communities; a forced count is a prespecified sensitivity analysis."
        },
        "cluster_forced_count_sensitivity_acknowledged": {
          "type": "boolean",
          "default": false,
          "description": "Required acknowledgement that a nonzero forced cluster count is sensitivity-only and not the graph-derived primary result."
        },
        "cluster_snn_k": {"type": "integer", "minimum": 2, "default": 50},
        "cluster_landmark_cells": {"type": "integer", "minimum": 2, "default": 10000},
        "cluster_landmark_assign_k": {"type": "integer", "minimum": 1, "default": 50},
        "cluster_landmark_sample_strategy": {"type": "string", "enum": ["knn_inverse_distance"], "default": "knn_inverse_distance"},
        "cluster_landmark_density_power": {"type": "number", "exclusiveMinimum": 0, "default": 2.0},
        "cluster_resolution": {
          "oneOf": [
            {"const": "auto"},
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "string", "pattern": "^(?:0*[1-9][0-9]*(?:\\.[0-9]+)?|0*\\.[0-9]*[1-9][0-9]*)$"}
          ],
          "default": 0.3
        },
        "cluster_stability_runs": {"type": "integer", "minimum": 2, "default": 3},
        "cluster_assignment_min_vote_margin": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.1},
        "cluster_stability_min_fraction": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.67},
        "cluster_abstain_uncertain": {"type": "boolean", "default": true},
        "cluster_primary_variant": {"type": "string", "const": "standard", "default": "standard"},
        "cluster_secondary_variant": {"type": "string", "enum": ["none", "fine"], "default": "none"},
        "cluster_secondary_profile": {"type": "string", "const": "fine", "default": "fine"}
      }
    },
    "outcome_options": {
      "title": "Section embedding and outcome research",
      "type": "object",
      "properties": {
        "titan_enable": {"type": "boolean", "default": false},
        "pathofmpred_enable": {"type": "boolean", "default": false},
        "pathofmpred_cancer": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]*$",
          "default": "",
          "description": "Explicit intended TCGA cancer code; it is never inferred from a filename."
        },
        "pathofmpred_include_limited_evidence": {"type": "boolean", "default": false},
        "neoplastic_section_require_cells": {"type": "boolean", "default": true},
        "titan_target_mpp": {"type": "number", "exclusiveMinimum": 0, "default": 0.5}
      }
    },
    "stage_name": {
      "type": "string",
      "enum": ["convert", "grandqc", "stardist", "cell_consensus", "tma", "tissue_mask", "cell_assignment", "cytoplasm", "gigatime", "marker_quantification", "grid_tiles", "uni2", "kodama", "clustering", "cluster_mask", "grow_tissue", "medsam_refine", "cluster_geojson", "neoplastic_section", "titan", "pathofmpred"],
      "default": "convert"
    },
    "auto_positive_integer": {
      "oneOf": [
        {"const": "auto"},
        {"type": "integer", "minimum": 1}
      ],
      "default": "auto"
    }
  },
  "allOf": [
    {"$ref": "#/definitions/input_output_options"},
    {"$ref": "#/definitions/scientific_design_options"},
    {"$ref": "#/definitions/runtime_options"},
    {"$ref": "#/definitions/input_qc_options"},
    {"$ref": "#/definitions/cell_options"},
    {"$ref": "#/definitions/gigatime_options"},
    {"$ref": "#/definitions/representation_options"},
    {"$ref": "#/definitions/outcome_options"},
    {
      "if": {"properties": {"grandqc_enable": {"const": false}}, "required": ["grandqc_enable"]},
      "then": {"properties": {"end_point": {"const": "convert"}}, "required": ["end_point"]}
    },
    {
      "if": {"properties": {"analysis_intent": {"const": "cell_phenotyping"}}, "required": ["analysis_intent"]},
      "then": {"properties": {"uni2_sampling_mode": {"const": "grid"}}, "required": ["uni2_sampling_mode"]}
    },
    {
      "if": {"properties": {"analysis_intent": {"const": "tissue_domain_discovery"}}, "required": ["analysis_intent"]},
      "then": {"properties": {"uni2_sampling_mode": {"const": "grid"}}, "required": ["uni2_sampling_mode"]}
    },
    {
      "if": {"properties": {"analysis_intent": {"const": "virtual_staining"}}, "required": ["analysis_intent"]},
      "then": {"properties": {"gigatime_enable": {"const": true}}, "required": ["gigatime_enable"]}
    },
    {
      "if": {"properties": {"analysis_intent": {"const": "outcome_prediction"}}, "required": ["analysis_intent"]},
      "then": {
        "properties": {"pathofmpred_enable": {"const": true}, "pathofmpred_cancer": {"type": "string", "minLength": 2}},
        "required": ["pathofmpred_enable", "pathofmpred_cancer"]
      }
    },
    {
      "if": {"properties": {"cell_detection_mode": {"const": "consensus"}}, "required": ["cell_detection_mode"]},
      "then": {"properties": {"compute_device": {"enum": ["auto", "gpu"]}}, "required": ["compute_device"]}
    },
    {
      "if": {"properties": {"uni2_sampling_mode": {"const": "grid"}}, "required": ["uni2_sampling_mode"]},
      "then": {
        "properties": {
          "uni2_encoder": {"const": "virchow2"},
          "uni2_include_inner_square": {"const": false},
          "uni2_fuse_tile_inner_square": {"const": false},
          "uni2_use_roi_crop": {"const": true}
        },
        "required": ["uni2_encoder", "uni2_include_inner_square", "uni2_fuse_tile_inner_square", "uni2_use_roi_crop"]
      }
    },
    {
      "if": {"properties": {"cluster_target_clusters": {"minimum": 2}}, "required": ["cluster_target_clusters"]},
      "then": {
        "properties": {"cluster_forced_count_sensitivity_acknowledged": {"const": true}},
        "required": ["cluster_forced_count_sensitivity_acknowledged"]
      }
    },
    {
      "if": {"properties": {"pathofmpred_enable": {"const": true}}, "required": ["pathofmpred_enable"]},
      "then": {"properties": {"pathofmpred_cancer": {"type": "string", "minLength": 2}}, "required": ["pathofmpred_cancer"]}
    }
  ]
}

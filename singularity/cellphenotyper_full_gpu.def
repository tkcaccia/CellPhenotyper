Bootstrap: docker
From: ubuntu:22.04

%files
  stardist.yml /opt/stardist.yml

%post
  set -e
  export DEBIAN_FRONTEND=noninteractive

  apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git build-essential pkg-config \
    libcurl4-openssl-dev libssl-dev libxml2-dev libgit2-dev libicu-dev \
    libfontconfig1-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
    libharfbuzz-dev libfribidi-dev libglpk-dev \
    gfortran \
    openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

  # micromamba install (arch-aware)
  MM_ARCH="$(uname -m)"
  if [ "${MM_ARCH}" = "x86_64" ]; then
    MM_PLATFORM="linux-64"
  elif [ "${MM_ARCH}" = "aarch64" ] || [ "${MM_ARCH}" = "arm64" ]; then
    MM_PLATFORM="linux-aarch64"
  else
    echo "Unsupported architecture for GPU image build: ${MM_ARCH}" >&2
    exit 1
  fi

  curl -fL --retry 5 --retry-delay 2 --retry-all-errors \
    -o /tmp/micromamba.tar.bz2 \
    "https://micro.mamba.pm/api/micromamba/${MM_PLATFORM}/latest"
  bzip2 -t /tmp/micromamba.tar.bz2
  tar -xvjf /tmp/micromamba.tar.bz2 -C /tmp bin/micromamba
  install -m 0755 /tmp/bin/micromamba /usr/local/bin/micromamba
  rm -rf /tmp/micromamba.tar.bz2 /tmp/bin

  export MAMBA_ROOT_PREFIX=/opt/micromamba
  retry_cmd() {
    local n=1
    local max=3
    local delay=10
    while true; do
      "$@" && break
      if [ "$n" -ge "$max" ]; then
        return 1
      fi
      n=$((n+1))
      sleep "$delay"
    done
  }

  # Base environment from project spec
  retry_cmd micromamba create -y -n stardist -f /opt/stardist.yml -c conda-forge
  # Prefer micromamba runtime libs during build-time import checks.
  export STARDIST_ENV_LIB=/opt/micromamba/envs/stardist/lib
  export LD_LIBRARY_PATH="${STARDIST_ENV_LIB}:${LD_LIBRARY_PATH:-}"

  # Ensure key Python modules are available.
  # Avoid importing stardist before TF check, because runtime backend import can fail.
  if ! micromamba run -n stardist python - <<'PY' >/dev/null 2>&1; then
import importlib.util, sys
mods = ("stardist", "csbdeep")
missing = [m for m in mods if importlib.util.find_spec(m) is None]
sys.exit(0 if not missing else 1)
PY
    micromamba run -n stardist pip install --no-cache-dir stardist csbdeep
  fi
  if ! micromamba run -n stardist python -c "import tensorflow" >/dev/null 2>&1; then
    micromamba run -n stardist pip install --no-cache-dir tensorflow==2.20.0
  fi
  if ! micromamba run -n stardist python -c "import imagecodecs" >/dev/null 2>&1; then
    micromamba run -n stardist pip install --no-cache-dir imagecodecs
  fi

  # CUDA-enabled PyTorch for GPU embeddings path.
  # amd64: conda CUDA runtime path.
  # arm64 (e.g. GB10 / sm_121): use nightly cu130 wheels because
  # stable cu126 arm64 wheels are built only for sm_80/sm_90.
  if [ "${MM_ARCH}" = "x86_64" ]; then
    micromamba install -y -n stardist -c nvidia -c pytorch -c conda-forge \
      pytorch torchvision pytorch-cuda=12.4
  else
    micromamba remove -y -n stardist pytorch torchvision libtorch torchvision-extra-decoders || true
    micromamba run -n stardist python -m pip install --no-cache-dir --upgrade pip
    micromamba run -n stardist pip install --no-cache-dir --force-reinstall --pre \
      --index-url https://download.pytorch.org/whl/nightly/cu130 \
      torch torchvision
    # Re-install UNI-2 runtime deps that can be removed together with conda pytorch.
    micromamba run -n stardist pip install --no-cache-dir --upgrade \
      timm==1.0.24 accelerate==1.12.0
  fi

  micromamba run -n stardist python - <<'PY'
import torch
print(f"[INFO] PyTorch build: version={torch.__version__} cuda={torch.version.cuda}")
if not torch.backends.cuda.is_built():
    raise SystemExit("FATAL: GPU image build produced CPU-only PyTorch")
if not torch.version.cuda:
    raise SystemExit("FATAL: GPU image build has no CUDA runtime tag in PyTorch")
print(f"[INFO] PyTorch CUDA arch list: {torch.cuda.get_arch_list()}")
PY

  # OME tools
  micromamba install -y -n stardist -c ome -c conda-forge bioformats2raw raw2ometiff

  # R + dependencies in same environment
  micromamba install -y -n stardist \
    -c conda-forge -c bioconda --channel-priority strict \
    rasterio affine \
    r-base r-devtools r-data.table r-irlba r-biocmanager r-remotes r-r.utils r-igraph \
    bioconductor-bluster

  # Bioconductor / GitHub packages
  micromamba run -n stardist Rscript -e 'devtools::install_github("xzhoulab/SPARK")'
  micromamba run -n stardist Rscript -e 'devtools::install_github("tkcaccia/KODAMA")'
  micromamba run -n stardist Rscript -e 'devtools::install_github("tkcaccia/KODAMAextra")'

  micromamba clean -a -y

%environment
  export LANG=C.UTF-8
  export LC_ALL=C.UTF-8
  export MAMBA_ROOT_PREFIX=/opt/micromamba
  export PATH=/opt/micromamba/envs/stardist/bin:$PATH
  export LD_LIBRARY_PATH=/opt/micromamba/envs/stardist/lib:$LD_LIBRARY_PATH

%runscript
  exec "$@"

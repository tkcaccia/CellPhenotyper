Bootstrap: docker
From: ubuntu:22.04

%files
  stardist.yml /opt/stardist.yml
  docker/requirements.grandqc.base.txt /opt/cellphenotyper/docker/requirements.grandqc.base.txt
  docker/requirements.grandqc.infer.txt /opt/cellphenotyper/docker/requirements.grandqc.infer.txt

%post
  set -e
  export DEBIAN_FRONTEND=noninteractive
  # Avoid tmpfs (/tmp) exhaustion during pip/conda build operations.
  export TMPDIR=/var/tmp
  export PIP_CACHE_DIR=/var/tmp/pip-cache
  mkdir -p "${PIP_CACHE_DIR}"

  apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git build-essential pkg-config \
    libcurl4-openssl-dev libssl-dev libxml2-dev libgit2-dev libicu-dev \
    libfontconfig1-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
    libharfbuzz-dev libfribidi-dev libglpk-dev \
    libopenslide0 \
    libvips42 \
    gfortran \
    openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

  mkdir -p /opt/cellphenotyper/third_party /opt/cellphenotyper/docker
  git clone --depth 1 https://github.com/bowang-lab/MedSAM /opt/cellphenotyper/third_party/MedSAM
  mkdir -p /opt/cellphenotyper/third_party/MedSAM/work_dir/MedSAM
  wget -q -O /opt/cellphenotyper/third_party/MedSAM/work_dir/MedSAM/medsam_vit_b.pth "https://zenodo.org/records/10689643/files/medsam_vit_b.pth?download=1"
  mkdir -p /opt/cellphenotyper/third_party/grandqc/pydeps /opt/cellphenotyper/third_party/grandqc/models/td /opt/cellphenotyper/third_party/grandqc/models/qc
  chmod -R a+rX /opt/cellphenotyper/third_party/MedSAM

  # micromamba install (arch-aware)
  MM_ARCH="$(uname -m)"
  if [ "${MM_ARCH}" = "x86_64" ]; then
    MM_PLATFORM="linux-64"
  elif [ "${MM_ARCH}" = "aarch64" ] || [ "${MM_ARCH}" = "arm64" ]; then
    MM_PLATFORM="linux-aarch64"
  else
    echo "Unsupported architecture for micromamba: ${MM_ARCH}" >&2
    exit 1
  fi

  curl -fL --retry 5 --retry-delay 2 --retry-all-errors \
    -o /tmp/micromamba.tar.bz2 \
    "https://micro.mamba.pm/api/micromamba/${MM_PLATFORM}/latest"
  bzip2 -t /tmp/micromamba.tar.bz2
  tar -xvjf /tmp/micromamba.tar.bz2 -C /tmp bin/micromamba
  install -m 0755 /tmp/bin/micromamba /usr/local/bin/micromamba
  rm -rf /tmp/micromamba.tar.bz2 /tmp/bin

  export MAMBA_ROOT_PREFIX=/opt/micromamba
  retry_cmd() {
    local n=1
    local max=3
    local delay=10
    while true; do
      "$@" && break
      if [ "$n" -ge "$max" ]; then
        return 1
      fi
      n=$((n+1))
      sleep "$delay"
    done
  }

  # Python environment
  retry_cmd micromamba create -y -n stardist -f /opt/stardist.yml -c conda-forge
  # Prefer micromamba runtime libs during build-time import checks.
  export STARDIST_ENV_LIB=/opt/micromamba/envs/stardist/lib
  export LD_LIBRARY_PATH="${STARDIST_ENV_LIB}:${LD_LIBRARY_PATH:-}"

  # Ensure key Python modules are available even when conda/pip resolution differs by arch.
  # Avoid importing stardist here, because import can fail when TF backend is not yet installed.
  if ! micromamba run -n stardist python - <<'PY' >/dev/null 2>&1; then
import importlib.util, sys
mods = ("stardist", "csbdeep")
missing = [m for m in mods if importlib.util.find_spec(m) is None]
sys.exit(0 if not missing else 1)
PY
    micromamba run -n stardist pip install --no-cache-dir stardist csbdeep
  fi
  # StarDist requires TensorFlow backend. Install it at build time if missing.
  if ! micromamba run -n stardist python -c "from stardist.models import StarDist2D" >/dev/null 2>&1; then
    micromamba run -n stardist pip install --no-cache-dir tensorflow==2.16.2
  fi
  if ! micromamba run -n stardist python -c "import imagecodecs" >/dev/null 2>&1; then
    micromamba run -n stardist pip install --no-cache-dir imagecodecs
  fi

  micromamba run -n stardist pip install --no-cache-dir --upgrade rasterio affine pyvips openslide-python aicsimageio aicspylibczi

  # Final hard check for required runtime modules.
  micromamba run -n stardist python - <<'PY'
import importlib
mods = ["tensorflow", "stardist", "csbdeep", "torch", "timm", "imagecodecs", "tifffile"]
missing = []
for m in mods:
    try:
        importlib.import_module(m)
    except Exception as e:
        missing.append(f"{m}: {e}")
if missing:
    raise SystemExit("Missing runtime modules:\n" + "\n".join(missing))
print("Container runtime module check passed")
PY

  # OME tools
  micromamba install -y -n stardist -c ome -c conda-forge bioformats2raw raw2ometiff

  # R + dependencies in same environment
  micromamba install -y -n stardist \
    -c conda-forge -c bioconda --channel-priority strict \
    rasterio affine \
    r-base r-devtools r-data.table r-irlba r-biocmanager r-remotes r-r.utils r-igraph r-umap \
    bioconductor-bluster
  mkdir -p /root/.R
  printf '%s\n' 'CXX11STD=-std=gnu++14' 'CXX14STD=-std=gnu++14' > /root/.R/Makevars

  # Bioconductor / GitHub packages
  micromamba run -n stardist Rscript -e 'devtools::install_github("xzhoulab/SPARK")'
  micromamba run -n stardist Rscript -e 'devtools::install_github("tkcaccia/KODAMA")'
  micromamba run -n stardist Rscript -e 'devtools::install_github("tkcaccia/KODAMAextra")'
  micromamba run -n stardist Rscript -e 'library(KODAMA); library(KODAMAextra); library(SPARK); library(umap); cat("R runtime package check passed\n")'

  micromamba run -n stardist python -m pip install --no-cache-dir --upgrade \
    --target /opt/cellphenotyper/third_party/grandqc/pydeps \
    -r /opt/cellphenotyper/docker/requirements.grandqc.base.txt
  micromamba run -n stardist python -m pip install --no-cache-dir --upgrade --no-deps \
    --target /opt/cellphenotyper/third_party/grandqc/pydeps \
    -r /opt/cellphenotyper/docker/requirements.grandqc.infer.txt
  wget -q -O /opt/cellphenotyper/third_party/grandqc/models/td/Tissue_Detection_MPP10.pth "https://zenodo.org/records/14507273/files/Tissue_Detection_MPP10.pth?download=1"
  wget -q -O /opt/cellphenotyper/third_party/grandqc/models/qc/GrandQC_MPP1.pth "https://zenodo.org/records/14041538/files/GrandQC_MPP1.pth?download=1"
  wget -q -O /opt/cellphenotyper/third_party/grandqc/models/qc/GrandQC_MPP15.pth "https://zenodo.org/records/14041538/files/GrandQC_MPP15.pth?download=1"
  wget -q -O /opt/cellphenotyper/third_party/grandqc/models/qc/GrandQC_MPP2.pth "https://zenodo.org/records/14041538/files/GrandQC_MPP2.pth?download=1"
  printf '%s\n' 'GrandQC bundled runtime' 'License: CC BY-NC-SA 4.0' 'Source: https://github.com/cpath-ukk/grandqc' 'Paper DOI: 10.1038/s41467-024-54769-y' > /opt/cellphenotyper/third_party/grandqc/NOTICE.txt
  env PYTHONPATH=/opt/cellphenotyper/third_party/grandqc/pydeps micromamba run -n stardist python - <<'PY'
import importlib
mods = [
    "cv2", "numpy", "PIL", "tifffile", "zarr", "numcodecs", "skimage", "imagecodecs",
    "segmentation_models_pytorch", "timm", "pretrainedmodels", "efficientnet_pytorch",
]
missing = []
for m in mods:
    try:
        importlib.import_module(m)
    except Exception as e:
        missing.append(f"{m}: {e}")
if missing:
    raise SystemExit("GrandQC bundled runtime check failed:\n" + "\n".join(missing))
print("GrandQC bundled runtime check passed")
PY
  chmod -R a+rX /opt/cellphenotyper/third_party/grandqc

  micromamba clean -a -y

%environment
  export LANG=C.UTF-8
  export LC_ALL=C.UTF-8
  export MAMBA_ROOT_PREFIX=/opt/micromamba
  export PATH=/opt/micromamba/envs/stardist/bin:$PATH
  export LD_LIBRARY_PATH=/opt/micromamba/envs/stardist/lib:$LD_LIBRARY_PATH
  export GRANDQC_HOME=/opt/cellphenotyper/third_party/grandqc
  export MEDSAM_REPO_DIR=/opt/cellphenotyper/third_party/MedSAM
  export MEDSAM_CHECKPOINT=/opt/cellphenotyper/third_party/MedSAM/work_dir/MedSAM/medsam_vit_b.pth

%runscript
  exec "$@"
